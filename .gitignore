# Firmware images are published as GitHub release assets, not committed: the FD
# is 30 MB and would be permanent in history.  See artifacts/README.md.
/artifacts/*.fd
/artifacts/*.bin
/artifacts/*.macho

# Local build output
/build/
/tools/siliconcamp-assistant/build/
__pycache__/
*.pyc

# Raw probe captures are local evidence: they can contain MAC addresses and
# other machine identifiers.  Redacted notes belong in docs/probes/ instead.
/probes/

# Editor and OS noise
.DS_Store
*.swp
.idea/
.vscode/
