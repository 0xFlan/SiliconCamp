+/*
+ * Deliver everything queued for this CPU that the guest currently allows.
+ *
+ * The queues exist because an interrupt can arrive while the guest has it
+ * disabled or while every list register is busy; the interrupt must survive
+ * that.  A FIFO that stops at its first undeliverable entry is not enough: a
+ * guest that has SGI 0 disabled would also stop receiving SGI 1, so this
+ * compacts instead, keeping the undeliverable entries in order and injecting
+ * the rest.
+ *
+ * The whole pass runs under the queue lock.  Producers push from other CPUs
+ * and from interrupt context, so compaction has to be invisible to them; the
+ * reader/consumer is only ever this CPU.
+ */
+static void hv_vgic3_drain_queue(virq_queue_t *q)
+{
+#ifdef ENABLE_VGIC_MODULE
+    spin_lock(&q->p_lock);
+
+    u32 tail = __atomic_load_n(&q->tail, __ATOMIC_RELAXED);
+    u32 head = __atomic_load_n(&q->head, __ATOMIC_ACQUIRE);
+    u32 kept = 0;
+
+    for (u32 i = tail; i != head; i++) {
+        virq_t pending = q->buf[i & (VIRQ_QUEUE_SIZE - 1)];
+
+        //
+        // hv_vgic3_inject_irq() re-checks the enable state, so an interrupt
+        // enabled between the test and the injection is not lost.
+        //
+        if (hv_vgic3_irq_enabled(pending.vintid) &&
+            hv_vgic3_inject_irq(
+                pending.vintid,
+                pending.priority,
+                pending.active,
+                pending.pending,
+                pending.hw_status,
+                pending.hw_irq
+            ))
+            continue;
+
+        q->buf[(tail + kept) & (VIRQ_QUEUE_SIZE - 1)] = pending;
+        kept++;
+    }
+
+    if (kept != (head - tail)) {
+        __atomic_store_n(&q->head, tail + kept, __ATOMIC_RELEASE);
+        sysop("dsb ishst");
+    }
+
+    spin_unlock(&q->p_lock);
+#endif
+}
+
+/*
+ * Drain every queue for this CPU.  Called when the guest enables something, so
+ * a pending interrupt is delivered at the point the guest asked for it rather
+ * than whenever the next unrelated interrupt happens to arrive.
+ */
+void hv_vgic3_drain_pending(void)
+{
+#ifdef ENABLE_VGIC_MODULE
+    if (!vgic_inited)
+        return;
+
+    hv_vgic3_drain_queue(&PERCPU(timer_queue));
+    hv_vgic3_drain_queue(&PERCPU(sgi_queue));
+    hv_vgic3_drain_queue(&PERCPU(irq_queue));
+#endif
+}
