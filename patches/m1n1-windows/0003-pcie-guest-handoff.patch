diff --git a/src/pcie_guest.c b/src/pcie_guest.c
new file mode 100644
index 00000000..376abdc7
--- /dev/null
+++ b/src/pcie_guest.c
@@ -0,0 +1,371 @@
+/* SPDX-License-Identifier: MIT */
+
+#include "adt.h"
+#include "dart.h"
+#include "hv.h"
+#include "pcie_guest.h"
+#include "soc.h"
+#include "string.h"
+#include "types.h"
+#include "utils.h"
+
+/*
+ * PCIe hand-off to a guest OS that has no APCIE, DART or SART driver.
+ *
+ * m1n1's usual answer for PCIe is pcie_shutdown(): m1n1 uses the controllers
+ * itself and then quiesces them so that the guest's own APCIE driver can bring
+ * them up from a clean state.  That works for macOS (and for Linux, which
+ * drives the controller the same way), and it is exactly wrong for Windows:
+ * neither Windows nor the UEFI firmware that loads it contains a single line of
+ * code that touches an APCIE register.  For those guests m1n1 has to leave the
+ * controllers in the state iBoot left them in and do the two things that the
+ * guest's PCIe stack assumes have already happened:
+ *
+ *  1. The guest's stage 2 has to contain the controller's MMIO.  A guest access
+ *     to an unmapped IPA is fatal (hv_handle_dabort() prints "HV: Unmapped IPA"
+ *     and returns an unhandled exception), so the ECAM -- which the guest's PCI
+ *     bus driver polls from the first line of PCI enumeration -- and the host
+ *     windows that device BARs are assigned from both have to be mapped before
+ *     the guest starts.
+ *
+ *  2. The controller's DARTs have to let device DMA through.  The guest runs
+ *     with an identity stage 2 (IPA == PA), so the state that matches it is
+ *     bypass: the device DMAs to the raw physical address its driver
+ *     programmed.  See dart_bypass_adt().
+ *
+ * Everything here is read-only towards the ADT, and the report it prints is the
+ * only place where the captured constants this repository's firmware and ACPI
+ * tables are built from (docs/pcie.md) meet the machine that is actually
+ * running.  Every value it prints is prefixed with "pcie:" so a bring-up log
+ * can be read with grep.
+ */
+
+extern uint64_t vaddr_bits;
+
+/* Deep enough for /arm-io/apciec0/dart-apciec0; the ADT is shallower than this. */
+#define PCIE_ADT_MAX_DEPTH 6
+#define PCIE_PATH_LEN      128
+
+/*
+ * Guest BAR windows.
+ *
+ * The ADT describes the controllers themselves (ECAM, PHY and port registers),
+ * but not the host side of their outbound windows -- and that is the space a
+ * device BAR is assigned from and the space the guest has to be able to reach.
+ * The values below are the captured J624 (Mac16,3) windows that this
+ * repository's platform PCDs and ACPI tables are built from (docs/pcie.md,
+ * docs/hardware-values.md).  They are host addresses, which is what the guest
+ * uses for both config space and BARs.
+ *
+ * A SoC without an entry gets its ECAM mapped and a warning: the windows cannot
+ * be guessed, and mapping the wrong ones would only move the failure.
+ */
+struct pcie_window {
+    u32 chip;
+    u64 base;
+    u64 size;
+    const char *name;
+};
+
+static const struct pcie_window pcie_windows[] = {
+    {T8132, 0xB80000000ULL, 0x40000000ULL, "32-bit non-prefetchable window"},
+    {T8132, 0xBC0000000ULL, 0x20000000ULL, "prefetchable window"},
+};
+
+struct pcie_state {
+    bool apply;
+    int controllers;
+    int darts;
+    int bypassed;
+    int mapped;
+};
+
+/*
+ * The ADT stores `compatible` as a list of NUL-terminated strings and a node
+ * commonly carries several.  Matching a prefix covers every APCIE generation
+ * with one rule: "apcie,t8103", "apcie,t6020", "apcie-ge,t6020" and
+ * "apcie,t8132" all start with "apcie".
+ */
+static bool compatible_has_prefix(int node, const char *prefix)
+{
+    u32 len = 0;
+    const char *list = adt_getprop(adt, node, "compatible", &len);
+
+    if (!list)
+        return false;
+
+    size_t prefix_len = strlen(prefix);
+
+    for (u32 offset = 0; offset < len;) {
+        const char *entry = list + offset;
+        size_t entry_len = strlen(entry);
+
+        if (entry_len >= prefix_len && !strncmp(entry, prefix, prefix_len))
+            return true;
+
+        offset += entry_len + 1;
+    }
+
+    return false;
+}
+
+/*
+ * A property that may or may not be a 64-bit value: the ADT is all 32-bit cells,
+ * but addresses are written as two cells on some SoCs and one on others, so
+ * accept both instead of guessing per property.
+ */
+static bool prop_u64(int node, const char *name, u64 *out)
+{
+    u32 len = 0;
+    const void *prop = adt_getprop(adt, node, name, &len);
+
+    if (!prop)
+        return false;
+
+    if (len == sizeof(u32)) {
+        u32 val;
+        memcpy(&val, prop, sizeof(val));
+        *out = val;
+        return true;
+    }
+
+    if (len == sizeof(u64)) {
+        memcpy(out, prop, sizeof(*out));
+        return true;
+    }
+
+    return false;
+}
+
+static bool prop_u64_any(int node, const char *const *names, u64 *out)
+{
+    for (int i = 0; names[i]; i++)
+        if (prop_u64(node, names[i], out))
+            return true;
+
+    return false;
+}
+
+/*
+ * Map one host region into the guest's stage 2 unless it is mapped already.
+ * Returns 1 when this call created the mapping, 0 when it was already there and
+ * -1 when it could not be mapped at all.
+ */
+static int map_guest_region(u64 base, u64 size, const char *what)
+{
+    size = ALIGN_DOWN(size, SZ_16K);
+
+    if (!base || !size)
+        return -1;
+
+    if (base + size > (1ULL << vaddr_bits)) {
+        printf("pcie: %s at 0x%lx+0x%lx does not fit the guest's %lu-bit address space\n", what,
+               base, size, vaddr_bits);
+        return -1;
+    }
+
+    if (hv_pt_walk(base)) {
+        printf("pcie: %s at 0x%lx+0x%lx is already mapped in the guest\n", what, base, size);
+        return 0;
+    }
+
+    if (hv_map_hw(base, base, size)) {
+        printf("pcie: failed to map %s at 0x%lx+0x%lx in the guest\n", what, base, size);
+        return -1;
+    }
+
+    printf("pcie: mapped %s for the guest: 0x%lx+0x%lx\n", what, base, size);
+
+    return 1;
+}
+
+static int pcie_controller_cb(int node, const char *path, void *arg)
+{
+    static const char *const msi_address_props[] = {"msi-address", NULL};
+    static const char *const msi_vector_count_props[] = {"msi-vectors", "#msi-vectors", NULL};
+    struct pcie_state *state = arg;
+    int offsets[8];
+    u64 ecam, ecam_size, val;
+    u32 ports;
+
+    if (!compatible_has_prefix(node, "apcie"))
+        return 0;
+
+    state->controllers++;
+
+    if (adt_path_offset_trace(adt, path, offsets) < 0) {
+        printf("pcie: cannot trace %s\n", path);
+        return 0;
+    }
+
+    if (adt_get_reg(adt, offsets, "reg", 0, &ecam, &ecam_size)) {
+        printf("pcie: %s has no ECAM (reg[0])\n", path);
+        return 0;
+    }
+
+    printf("pcie: controller %s: ECAM 0x%lx+0x%lx\n", path, ecam, ecam_size);
+
+    if (ADT_GETPROP(adt, node, "#ports", &ports) >= 0)
+        printf("pcie: controller %s: %d port(s)\n", path, ports);
+
+    /*
+     * MSI.  A device writes (msi-address, msi-vector-offset + vector) into its
+     * MSI or MSI-X capability, the controller turns that into an AIC interrupt
+     * and the vGIC passes it on to the guest.  Those two numbers are what an
+     * MSI-capable guest OS needs, and nothing else in the system publishes
+     * them, so they belong in the boot log next to the ECAM.
+     */
+    if (prop_u64_any(node, msi_address_props, &val))
+        printf("pcie: controller %s: msi-address 0x%lx\n", path, val);
+
+    if (prop_u64(node, "msi-vector-offset", &val))
+        printf("pcie: controller %s: msi-vector-offset 0x%lx\n", path, val);
+
+    if (prop_u64_any(node, msi_vector_count_props, &val))
+        printf("pcie: controller %s: %lu MSI vector(s)\n", path, val);
+
+    if (state->apply && map_guest_region(ecam, ecam_size, "APCIE ECAM") > 0)
+        state->mapped++;
+
+    return 0;
+}
+
+static int pcie_dart_cb(int node, const char *path, void *arg)
+{
+    struct pcie_state *state = arg;
+
+    if (!compatible_has_prefix(node, "dart,"))
+        return 0;
+
+    /*
+     * Only the controllers' own DARTs.  The display, ISP, AOP and USB DARTs
+     * belong to m1n1 or to the firmware, and bypassing those would take their
+     * translation away from the code that is using them.  Newer SoCs name the
+     * controllers apciec0-3 and their DARTs dart-apciecN; earlier ones use
+     * apcie and dart-apcieN.  Either way the DART's path contains "apcie".
+     */
+    if (!strstr(path, "apcie"))
+        return 0;
+
+    state->darts++;
+
+    if (!state->apply) {
+        dart_report_adt(path);
+        return 0;
+    }
+
+    if (!dart_bypass_adt(path))
+        state->bypassed++;
+
+    return 0;
+}
+
+static void pcie_map_windows(struct pcie_state *state)
+{
+    int found = 0;
+
+    for (size_t i = 0; i < ARRAY_SIZE(pcie_windows); i++) {
+        const struct pcie_window *win = &pcie_windows[i];
+
+        if (win->chip != chip_id)
+            continue;
+
+        found++;
+
+        if (map_guest_region(win->base, win->size, win->name) > 0)
+            state->mapped++;
+    }
+
+    if (!found)
+        printf("pcie: no captured host window for chip 0x%x; only the ECAMs are mapped.\n"
+               "      Add the windows from this machine's device tree to pcie_windows[] "
+               "before devices can be reached.\n",
+               chip_id);
+}
+
+/*
+ * Walk the ADT, calling `cb` for every node, and hand it the node's absolute
+ * path.  The path is built in place: the ADT has no back pointers, and the
+ * property helpers below take a path rather than an offset, so this keeps the
+ * two views of the same node consistent.
+ */
+typedef int (*pcie_walk_cb)(int node, const char *path, void *arg);
+
+static int pcie_walk(int node, char *path, size_t path_len, size_t depth, pcie_walk_cb cb,
+                     void *arg)
+{
+    int ret = cb(node, path, arg);
+
+    if (ret || depth >= PCIE_ADT_MAX_DEPTH)
+        return ret;
+
+    ADT_FOREACH_CHILD(adt, node)
+    {
+        const char *name = adt_get_name(adt, node);
+        size_t used = strlen(path);
+        size_t name_len;
+
+        if (!name)
+            continue;
+
+        name_len = strlen(name);
+
+        if (used + name_len + 2 > path_len)
+            continue;
+
+        path[used] = '/';
+        memcpy(path + used + 1, name, name_len + 1);
+
+        ret = pcie_walk(node, path, path_len, depth + 1, cb, arg);
+
+        /* Restore the parent path for the next sibling. */
+        path[used] = 0;
+
+        if (ret)
+            return ret;
+    }
+
+    return 0;
+}
+
+int pcie_guest_handoff(bool apply)
+{
+    struct pcie_state state = {.apply = apply};
+    char path[PCIE_PATH_LEN] = "";
+    int root = adt_path_offset(adt, "/");
+
+    if (root < 0) {
+        printf("pcie: no ADT, nothing to hand off\n");
+        return -1;
+    }
+
+    printf("pcie: %s the ADT for APCIE controllers and DARTs\n",
+           apply ? "preparing a guest hand-off from" : "reporting");
+
+    pcie_walk(root, path, sizeof(path), 0, pcie_controller_cb, &state);
+    pcie_walk(root, path, sizeof(path), 0, pcie_dart_cb, &state);
+
+    if (apply)
+        pcie_map_windows(&state);
+
+    printf("pcie: %d controller(s), %d mapped region(s), %d DART(s), %d bypassed\n",
+           state.controllers, state.mapped, state.darts, state.bypassed);
+
+    if (!state.controllers) {
+        printf("pcie: no APCIE controller in the ADT; the guest will not see PCIe\n");
+        return -1;
+    }
+
+    if (apply && state.darts != state.bypassed) {
+        printf("pcie: %d of %d APCIE DART(s) are not bypassed; device DMA will not work\n",
+               state.darts - state.bypassed, state.darts);
+        return -2;
+    }
+
+    return 0;
+}
+
+int pcie_guest_prepare(void)
+{
+    return pcie_guest_handoff(true);
+}
