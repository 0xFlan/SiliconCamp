+     * config.h to get the upstream behaviour back for a guest that owns the
+     * controller itself.
+     */
+#ifdef HV_QUIESCE_PCIE
+    pcie_shutdown();
+#else
+    pcie_guest_prepare();
+
+    /*
+     * MSI.  The controllers' doorbells and the AIC interrupts they raise are
+     * m1n1's to program, because the guest has no APCIE driver and the AIC is
+     * not a GIC: guest_msi.c programs the port MSI maps, unmasks the AIC and
