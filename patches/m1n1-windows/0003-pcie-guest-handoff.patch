 };
 
 dart_dev_t *dart_init(uintptr_t base, u8 device, bool keep_pts, enum dart_type_t type)
@@ -763,3 +801,177 @@ u64 dart_vm_base(dart_dev_t *dart)
 {
     return dart->vm_base;
 }
+
+/*
+ * Whole-DART operations.
+ *
+ * Everything above works on a single stream because that is all m1n1 needs for
+ * the devices it drives itself.  A guest OS with no DART driver needs the
+ * opposite property: every stream of the DART has to end up in one state that
+ * the guest can rely on, and the caller has to be able to verify that state
+ * afterwards.
+ *
+ * The state that makes device DMA work without an IOMMU driver in the guest is
+ * bypass.  TCR.BYPASS_DART makes the DART pass device transactions through
+ * untranslated, so a device DMAs to the raw physical address its driver
+ * programmed -- exactly what a guest running with an identity stage 2 wants.
+ * TCR.BYPASS_DAPF does the same for the CPU's accesses to device registers.
+ *
+ * TCR is banked per stream (one word per SID at params->tcr_off), so a full
+ * hand-over walks every stream instead of the single SID m1n1 happens to know
+ * about, and it reads the result back per stream: a DART that is locked or that
+ * ignores writes is reported rather than assumed.
+ */
+
+struct dart_adt_info {
+    enum dart_type_t type;
+    const struct dart_params *params;
+    const char *type_s;
+    u64 base;
+    bool locked;
+};
+
+/*
+ * Resolve an ADT DART node to a register base and an IP version without
+ * allocating page tables or changing any register.
+ */
+static int dart_adt_info(const char *path, struct dart_adt_info *info)
+{
+    int offsets[8];
+    int node = adt_path_offset_trace(adt, path, offsets);
+
+    if (node < 0)
+        return -1;
+
+    if (adt_is_compatible(adt, node, "dart,t8020")) {
+        info->type = DART_T8020;
+        info->params = &dart_t8020;
+        info->type_s = "t8020";
+    } else if (adt_is_compatible(adt, node, "dart,t6000")) {
+        info->type = DART_T6000;
+        info->params = &dart_t6000;
+        info->type_s = "t6000";
+    } else if (adt_is_compatible(adt, node, "dart,t8110")) {
+        info->type = DART_T8110;
+        info->params = &dart_t8110;
+        info->type_s = "t8110";
+    } else {
+        /*
+         * A DART IP version this tree does not know about.  Do not guess at a
+         * register layout: print what the ADT called it so the version can be
+         * added from the machine that reports it.
+         */
+        const char *compat = adt_getprop(adt, node, "compatible", NULL);
+        printf("dart: %s has unknown compatible \"%s\"\n", path, compat ? compat : "(none)");
+        return -2;
+    }
+
+    if (adt_get_reg(adt, offsets, "reg", 0, &info->base, NULL)) {
+        printf("dart: %s has no reg[0]\n", path);
+        return -1;
+    }
+
+    /*
+     * A locked DART has had its translation registers frozen, in practice by
+     * the secure monitor, and writes to them are ignored.
+     */
+    if (info->type == DART_T8110)
+        info->locked =
+            (read32(info->base + DART_T8110_PROTECT) & DART_T8110_PROTECT_TTBR_TCR) != 0;
+    else
+        info->locked = (read32(info->base + DART_T8020_CONFIG) & DART_T8020_CONFIG_LOCK) != 0;
+
+    return 0;
+}
+
+int dart_report_adt(const char *path)
+{
+    struct dart_adt_info info;
+    int translating = 0, bypassed = 0, other = 0;
+
+    if (dart_adt_info(path, &info) < 0)
+        return -1;
+
+    u32 bypass = (u32)info.params->tcr_disabled;
+    u32 translate = (u32)info.params->tcr_enabled;
+
+    for (int sid = 0; sid < info.params->sid_count; sid++) {
+        u32 tcr = read32(info.base + info.params->tcr_off + 4 * sid);
+
+        if ((tcr & bypass) == bypass)
+            bypassed++;
+        else if (tcr & translate)
+            translating++;
+        else
+            other++;
+    }
+
+    printf("dart: %s at 0x%lx is a %s%s with %d streams: %d bypassed, %d translating, %d other\n",
+           path, info.base, info.type_s, info.locked ? " (locked)" : "", info.params->sid_count,
+           bypassed, translating, other);
+
+    return 0;
+}
+
+int dart_bypass_adt(const char *path)
+{
+    struct dart_adt_info info;
+    dart_dev_t dev;
+    int stuck = 0;
+
+    if (dart_adt_info(path, &info) < 0)
+        return -1;
+
+    if (info.locked) {
+        printf("dart: %s is locked, leaving its %d streams alone\n", path, info.params->sid_count);
+        return -1;
+    }
+
+    /* The flush helpers take a device, and only use its register base. */
+    memset(&dev, 0, sizeof(dev));
+    dev.regs = info.base;
+    dev.device = 0;
+    dev.type = info.type;
+    dev.params = info.params;
+
+    /*
+     * Enable every stream.  An SID that is not enabled is not routed through
+     * this DART's translation logic at all, and which state it is in then is not
+     * something a guest can reason about.  All streams enabled and bypassed is a
+     * state that fits in one line.
+     */
+    if (info.type == DART_T8110) {
+        for (int word = 0; word < DART_T8110_ENABLE_STREAMS_WORDS; word++)
+            write32(info.base + DART_T8110_ENABLE_STREAMS + 4 * word, ~0U);
+    } else {
+        write32(info.base + DART_T8020_ENABLED_STREAMS, ~0U);
+    }
+
+    u32 bypass = (u32)info.params->tcr_disabled;
+
+    for (int sid = 0; sid < info.params->sid_count; sid++)
+        write32(info.base + info.params->tcr_off + 4 * sid, bypass);
+
+    /* Streams may already hold translated entries in the TLB. */
+    info.params->tlb_invalidate_all(&dev);
+
+    for (int sid = 0; sid < info.params->sid_count; sid++) {
+        u32 tcr = read32(info.base + info.params->tcr_off + 4 * sid);
+
+        if ((tcr & bypass) != bypass) {
+            if (!stuck)
+                printf("dart: %s stream %d still reads tcr=%#x\n", path, sid, tcr);
+            stuck++;
+        }
+    }
+
+    if (stuck) {
+        printf("dart: %s: %d of %d streams did not take bypass\n", path, stuck,
+               info.params->sid_count);
+        return -1;
+    }
+
+    printf("dart: %s: all %d streams bypassed\n", path, info.params->sid_count);
+
+    return 0;
+}
