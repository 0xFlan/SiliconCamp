             reg_num = (relative_addr - GIC_DIST_ISACTIVER0) / 4;
             u32 value_is_enabler, value_ic_enabler, current_val;
             value_is_enabler = distributor->gicd_interrupt_set_active_regs[reg_num];
@@ -787,21 +787,22 @@
