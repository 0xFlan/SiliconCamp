+/* Lines vgic_note() may emit before it goes quiet.  The hot path never uses it. */
+#define VGIC_WARN_BUDGET 32
+/* Accesses kept for post-mortem inspection. */
+#define VGIC_RING_SIZE 64
+
+/* What an exceptional event means, so the counters can be read without a log. */
+#define VGIC_NOTE_UNKNOWN    0 /* register the emulation does not know at all */
+#define VGIC_NOTE_RO         1 /* write to a read-only or RES0 field */
+#define VGIC_NOTE_UNMODELLED 2 /* register exists architecturally but has no model */
+#define VGIC_NOTE_KINDS      3
+
+/*
+ * One recorded access.  `space` is 'D' (distributor), 'R' (redistributor) or
+ * 'I' (ITS); `off` is the offset within that space, and within the frame for a
+ * redistributor, so a trace line reads the same way as the architectural
+ * register map.  `frame` is the redistributor frame index, or 0 elsewhere.
+ */
+typedef struct {
+    u64 val;
+    u32 off;
+    u8 space;
+    u8 frame;
+    u8 write;
+    u8 handled;
+    u8 width;
+} vgic_trace_entry;
+
+typedef struct {
+    u64 accesses;              /* every emulated access, handled or not */
+    u64 unknown;               /* VGIC_NOTE_UNKNOWN */
+    u64 ro_violation;          /* VGIC_NOTE_RO */
+    u64 unmodelled;            /* VGIC_NOTE_UNMODELLED */
+    u64 warnings;              /* lines vgic_note() actually printed */
+    u64 suppressed;            /* lines it refused to print */
+    u32 count;                 /* valid entries in ring, saturating */
+    u32 next;                  /* next ring slot */
+    vgic_trace_entry ring[VGIC_RING_SIZE];
+    /*
+     * One bit per 8 bytes of each space: did software ever touch it?  This is
+     * the question a hang asks and a trace cannot answer -- "did the guest wake
+     * redistributor 3 at all?" is one bit, not the last 64 accesses.  The
+     * redistributor bitmap is shared by all frames, so it answers "was this
+     * register ever accessed"; the ring says by which frame.
+     */
+    u64 dist_touched[0x10000 / 8 / 64];        /* distributor space is 64 KiB */
+    u64 redist_touched[GICR_FRAME_SIZE / 8 / 64]; /* one redistributor frame */
+} vgic_diag_t;
+
+vgic_diag_t vgic_diag;
+static u32 vgic_warned;
+
+/*
+ * Record one access.  Deliberately unsynchronised: a torn ring entry costs one
+ * confusing line in a post-mortem, while a lock here would cost the very thing
+ * this exists to avoid.  The two bitmaps use an atomic OR because a lost bit
+ * would be a false negative in the diagnostic that matters most.
+ */
+static void vgic_diag_touch(u64 *bitmap, u64 relative_addr)
+{
+    u64 bit = relative_addr >> 3;
+
+    __atomic_fetch_or(&bitmap[bit / 64], 1UL << (bit % 64), __ATOMIC_RELAXED);
+}
+
+static void vgic_diag_record(u8 space, u8 frame, u64 relative_addr, u64 val, bool write,
+                      bool handled, int width)
+{
+    vgic_trace_entry *entry;
+
+    vgic_diag.accesses++;
+
+    if (space == 'D' && relative_addr < 0x10000)
+        vgic_diag_touch(vgic_diag.dist_touched, relative_addr);
+    else if (space == 'R' && relative_addr < GICR_FRAME_SIZE)
+        vgic_diag_touch(vgic_diag.redist_touched, relative_addr);
+
+    entry = &vgic_diag.ring[vgic_diag.next];
+    entry->val = val;
+    entry->off = (u32)relative_addr;
+    entry->space = space;
+    entry->frame = frame;
+    entry->write = write ? 1 : 0;
+    entry->handled = handled ? 1 : 0;
+    entry->width = (u8)width;
+
+    vgic_diag.next = (vgic_diag.next + 1) % VGIC_RING_SIZE;
+    if (vgic_diag.count < VGIC_RING_SIZE)
+        vgic_diag.count++;
+}
+
+/*
+ * Account for one exceptional event, and decide whether to print it.  The
+ * budget is per boot, not per register, because the failure it guards against
+ * is a guest that loops on one register forever; the suppressed count is what
+ * tells a reader that the log was truncated.  Under SMP contention the
+ * increment can race, so the budget may over-run by at most num_cpus lines.
+ */
+static void vgic_diag_account(u8 kind)
+{
+    switch (kind) {
+    case VGIC_NOTE_UNKNOWN:
+        vgic_diag.unknown++;
+        break;
+    case VGIC_NOTE_RO:
+        vgic_diag.ro_violation++;
+        break;
+    case VGIC_NOTE_UNMODELLED:
+        vgic_diag.unmodelled++;
+        break;
+    }
+}
+
+static bool vgic_diag_wants_output(void)
+{
+    if (vgic_warned >= VGIC_WARN_BUDGET) {
+        vgic_diag.suppressed++;
+        return false;
+    }
+
+    vgic_diag.warnings = ++vgic_warned;
+    return true;
+}
+
+#define vgic_note(kind, ...)                                                                        \
+    do {                                                                                           \
+        vgic_diag_account(kind);                                                                   \
+        if (vgic_diag_wants_output())                                                              \
+            printf(__VA_ARGS__);                                                                   \
+    } while (0)
+
 
 vgicv3_dist *distributor;
 vgicv3_vcpu_redist *redistributors;
