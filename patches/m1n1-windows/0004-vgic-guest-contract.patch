diff --git a/src/hv_vgic.h b/src/hv_vgic.h
index 45e514e0..74db074b 100644
--- a/src/hv_vgic.h
+++ b/src/hv_vgic.h
@@ -119,11 +119,27 @@
 // Redistributor offsets
 //
 
+//
+// One redistributor owns a 64 KiB RD_base frame followed by a 64 KiB SGI_base
+// frame at offset 0x10000, so the next redistributor starts 0x20000 later.
+// GICv4 would double this to 0x40000 when GICR_TYPER.VLPIS is set; this vGIC
+// reports VLPIS=0, so 0x20000 is the contract it publishes.
+//
+#define GICR_FRAME_SIZE 0x20000
+
 #define GIC_REDIST_CTLR 0x0
 #define GIC_REDIST_IIDR 0x4
 #define GIC_REDIST_TYPER 0x8
 #define GIC_REDIST_STATUSR 0x10
 #define GIC_REDIST_WAKER 0x14
+
+//
+// GICR_WAKER (ARM IHI 0069): ProcessorSleep is bit 1, ChildrenAsleep is bit 2.
+// ChildrenAsleep is read-only and a guest that wakes a PE clears ProcessorSleep
+// and then polls ChildrenAsleep until it reads 0.
+//
+#define GICR_WAKER_PROCESSOR_SLEEP BIT(1)
+#define GICR_WAKER_CHILDREN_ASLEEP BIT(2)
 #define GIC_REDIST_MPAMIDR 0x18
 #define GIC_REDIST_PARTIDR 0x1C
 #define GIC_REDIST_SETLPIR 0x40
