diff --git a/src/guest_msi.c b/src/guest_msi.c
index 7446e4c7..ce97d617 100644
--- a/src/guest_msi.c
+++ b/src/guest_msi.c
@@ -356,3 +356,28 @@ u32 guest_msi_intid(u32 aic_irq)
 
     return GUEST_MSI_SPI_BASE + (aic_irq - guest_msi.aic_base);
 }
+
+/*
+ * Guest INTID -> AIC interrupt, for the paths that have to touch the physical
+ * interrupt controller (mask/unmask, affinity).  Keeping this the exact inverse
+ * of guest_msi_intid() is what makes the MSI window safe: a guest enable or
+ * disable of SPI 512+i names AIC aic_base+i, not AIC 512+i.
+ */
+u32 guest_msi_aic_irq(u32 intid)
+{
+    if (intid >= GUEST_MSI_SPI_BASE && intid <= GUEST_MSI_SPI_END) {
+        if (!guest_msi.valid)
+            return 0;
+        return guest_msi.aic_base + (intid - GUEST_MSI_SPI_BASE);
+    }
+
+    /*
+     * The AIC numbers its own interrupts the same way the GIC numbers SPIs up
+     * to the end of the architectural SPI range.  INTIDs 0-31 are SGIs/PPIs,
+     * which are private to the CPU interface and have no AIC line.
+     */
+    if (intid >= 32 && intid <= GIC_LAST_SPI)
+        return intid;
+
+    return 0;
+}
diff --git a/src/guest_msi.h b/src/guest_msi.h
index 96ed3e8b..dfd9b85c 100644
--- a/src/guest_msi.h
+++ b/src/guest_msi.h
@@ -68,4 +68,13 @@ void guest_msi_prepare(void);
  */
 u32 guest_msi_intid(u32 aic_irq);
 
+/*
+ * The inverse of guest_msi_intid() for the paths that operate on the AIC:
+ * masking or unmasking a guest INTID, or applying its affinity.  INTIDs 32-511
+ * are the AIC's own numbers; the MSI window (512-767) is backed by aic_base
+ * onwards.  Returns 0 for the SGI/PPI range and for any INTID that has no AIC
+ * source, so callers can skip the write instead of poking an unrelated line.
+ */
+u32 guest_msi_aic_irq(u32 intid);
+
 #endif
