@@ -0,0 +1,67 @@
+#
+#  Copyright (c) 2026, SiliconCamp contributors. All rights reserved.
+#
+#  Module Name:
+#    AppleVgicSelfTestDxe.inf
+#
+#  Abstract:
+#    Conformance self-test for the NTASP m1n1 vGIC that this platform's ACPI
+#    tables describe.  The firmware publishes a GICv3 distributor, ten
+#    redistributor frames and a GIC MSI Frame, but until this driver existed
+#    nothing in the image ever read them back.  A build that links is not a
+#    contract that holds; this driver walks the device the way a guest OS does,
+#    checks the properties the tables promise, and exercises real interrupt
+#    delivery through the architected CPU interface.
+#
+#    Every check either prints PASS, FAIL, GAP (a measured deviation from the
+#    architecture) or SKIP.  No check halts the boot: this runs before anything
+#    can be diagnosed, so a failure has to be loud and survivable.
+#
+#  Environment:
+#    UEFI Driver Execution Environment (DXE)
+#
+#  License:
+#    SPDX-License-Identifier: BSD-2-Clause-Patent
+#
+
+[Defines]
+  INF_VERSION                    = 0x0001001c
+  BASE_NAME                      = AppleVgicSelfTestDxe
+  FILE_GUID                      = 7b1f0a52-4c3e-4a8d-9f60-2d5c1e8b7a31
+  MODULE_TYPE                    = DXE_DRIVER
+  VERSION_STRING                 = 1.0
+  ENTRY_POINT                    = AppleVgicSelfTestInitialize
+
+[Sources]
+  AppleVgicSelfTestDxe.c
+
+[Packages]
+  MdePkg/MdePkg.dec
+  EmbeddedPkg/EmbeddedPkg.dec
+  ArmPkg/ArmPkg.dec
+  AppleSiliconPkg/AppleSiliconPkg.dec
+
+[LibraryClasses]
+  ArmLib
+  BaseLib
+  BaseMemoryLib
+  DebugLib
+  IoLib
+  PcdLib
+  PrintLib
+  TimerLib
+  UefiBootServicesTableLib
+  UefiDriverEntryPoint
+
+[Protocols]
+  gEfiCpuArchProtocolGuid          ## CONSUMES
+  gHardwareInterruptProtocolGuid   ## CONSUMES
+
+[Pcd]
+  gAppleSiliconPkgTokenSpaceGuid.PcdCoreCount
+  gArmTokenSpaceGuid.PcdGicDistributorBase
+  gArmTokenSpaceGuid.PcdGicRedistributorsBase
+  gArmTokenSpaceGuid.PcdArmArchTimerVirtIntrNum
+
+[Depex]
+  gEfiCpuArchProtocolGuid AND gHardwareInterruptProtocolGuid
