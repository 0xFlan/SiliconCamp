+//
+// Distributor registers, ARM IHI 0069.  Offsets are from the distributor base.
+// They are spelled out here rather than taken from ArmGicLib because that
+// library carries the GICv2 register names, and this test has to be written
+// against the architecture rather than against the header it shares with the
+// driver it is testing.
+//
+#define GICD_CTLR        0x0000
+#define GICD_TYPER       0x0004
+#define GICD_IIDR        0x0008
+#define GICD_TYPER2      0x000C
+#define GICD_IGROUPR     0x0080
+#define GICD_ISENABLER   0x0100
+#define GICD_ICENABLER   0x0180
+#define GICD_ISPENDR     0x0200
+#define GICD_ICPENDR     0x0280
+#define GICD_ISACTIVER   0x0300
+#define GICD_ICACTIVER   0x0380
+#define GICD_IPRIORITYR  0x0400
+#define GICD_IROUTER     0x6000
+
+#define GICD_CTLR_ENABLEGRP1NS  (1U << 0)
+#define GICD_CTLR_ARE           (1U << 4)
+#define GICD_CTLR_DS            (1U << 6)
+#define GICD_CTLR_RWP           (1U << 31)
+//
+// With DS = 1 the group-enable fields are bit 0 EnableGrp1, bit 1 EnableGrp0,
+// and bit 2 RAZ/WI (checked against QEMU's GICv3 model by
+// scripts/check-gicv3-oracle.py).  The name above is the two-security-state
+// name for the same bit; using bit 1 here would have tested Group 0 while the
+// message claimed Group 1, and both bits are set at reset, so the mistake
+// would have looked like a pass.
+//
+
+#define GICD_TYPER_ITLINES_MASK   (0x1FU << 0)
+#define GICD_TYPER_CPUNUMBER_MASK (0x1FU << 5)
+#define GICD_TYPER_SECURITYEXTN   (1U << 10)
+#define GICD_TYPER_LPIS           (1U << 17)
+#define GICD_TYPER_MBIS           (1U << 16)
+#define GICD_TYPER_IDBITS_MASK    (0x1FU << 19)
+#define GICD_TYPER_IDBITS_SHIFT   19
+#define GICD_TYPER_A3V            (1U << 24)
+#define GICD_TYPER_NO1N           (1U << 25)
+
+#define GICD_IROUTER_IRM  (1ULL << 31)
+
+//
+// Redistributor registers.  A redistributor is two 64 KB frames: the RD_base
+// frame at +0 and the SGI_base frame at +0x10000.
+//
+// There is no GICR_TYPER2.  Offset 0xC is the upper half of the 64-bit
+// GICR_TYPER, and a 32-bit access there is not a register of its own, so this
+// file never touches it.
+//
+#define GICR_CTLR    0x0000
+#define GICR_TYPER   0x0008
+#define GICR_WAKER   0x0014
+
+#define GICR_TYPER_PLPIS         (1ULL << 0)
+#define GICR_TYPER_VLPIS         (1ULL << 1)
+#define GICR_TYPER_DIRECTLPI     (1ULL << 3)
+#define GICR_TYPER_LAST          (1ULL << 4)
+#define GICR_TYPER_DPGS          (1ULL << 5)
+#define GICR_TYPER_PROCNUM_SHIFT 8
+#define GICR_TYPER_PROCNUM_MASK  (0xFFFFULL << 8)
+#define GICR_TYPER_AFFINITY_MASK (0xFFFFFFFFULL << 32)
+
+#define GICR_FRAME_SIZE  0x20000
+#define GICR_SGI_IGROUPR0   0x10080
+#define GICR_SGI_ISENABLER  0x10100
+#define GICR_SGI_ICENABLER  0x10180
+#define GICR_SGI_ISPENDR    0x10200
+#define GICR_SGI_ICPENDR    0x10280
+#define GICR_SGI_ISACTIVER  0x10300
+#define GICR_SGI_ICACTIVER  0x10380
+
+#define GICR_WAKER_PROCESSOR_SLEEP (1U << 1)
+#define GICR_WAKER_CHILDREN_ASLEEP (1U << 2)
+
+//
+// GICR_CTLR bits that must read as zero on this device: EnableLPIs (no LPIs),
+// RWP (the emulation applies writes before returning), and DPG0/DPG1NS/DPG1S
+// (RES0 because GICR_TYPER.DPGS is 0).
+//
+#define GICR_CTLR_RESERVED_WRITE_MASK \
+  ((1U << 0) | (1U << 3) | (1U << 24) | (1U << 25) | (1U << 26))
+
+//
+// The MSI window this platform's MADT GIC MSI Frame describes.  The ACPI half of
+// the claim is pinned by scripts/check-acpi.py, which compares the table against
+// src/guest_msi.h; this driver checks the other end, that the window fits inside
+// the INTID space the distributor reports.
+//
+#define VGIC_MSI_SPI_BASE 512
+#define VGIC_MSI_VECTORS  256
+#define VGIC_MSI_BANKS    (VGIC_MSI_VECTORS / 32)
+
+#define VGIC_SPURIOUS_INTID 1023
+
+//
+// A guest may not assume more redistributor frames than the platform declares,
+// and a test may not assume more than it can hold on the stack.
+//
+#define VGIC_MAX_FRAMES 64
+
+//
+// Timeouts, in microseconds.  Everything the vGIC does is synchronous, so these
+// are generous; a conforming device answers in the first poll.
+//
+#define VGIC_WAIT_REGISTER_US  10000
+#define VGIC_WAIT_IRQ_US      100000
+
+//
+// The window used for the negative delivery test.  It only has to be longer
+// than the working path takes (well under a millisecond), and keeping it short
+// keeps a passing boot quick.
+//
+#define VGIC_GATE_WINDOW_US  20000
+
+//
+// Which interrupt IDs the delivery tests use.  SGIs 9 and 10 are in the range
+// the GIC leaves to software; the PPI number comes from the same PCD the GTDT
+// is built from, so the two cannot drift.
+//
+#define VGIC_TEST_SGI        9
+#define VGIC_TEST_SGI_2      10
+//
+// The bank-semantics probe uses an SGI none of the delivery tests touch, so it
+// can save and restore a single bit without disturbing them.
+//
+#define VGIC_TEST_SGI_BANKS  13
+
+//
+// ICC_* and CNTV_* system registers, named by their generic encodings so this
+// file does not depend on a header that may not define them.
+//
+STATIC
+UINT64
+IccHppir1 (
+  VOID
+  )
+{
+  UINT64  Value;
+
+  __asm__ volatile ("mrs %0, S3_0_C12_C12_2" : "=r" (Value) :: "memory");
+  return Value;
+}
+
+STATIC
+UINT64
+IccCtlr (
+  VOID
+  )
+{
