+/** @file
+  Conformance self-test for the NTASP m1n1 vGIC.
+
+  The platform's ACPI tables promise a GICv3 distributor with 1024 INTIDs, one
+  redistributor frame per PE, single-security-state operation, and an MSI window
+  at SPIs 512-767.  Nothing in the image ever checked that the device m1n1
+  emulates actually behaves that way: a build that links is not a contract that
+  holds.
+
+  This driver walks the device the way a guest OS does and then delivers real
+  interrupts through the architected CPU interface.  It runs after ArmGicDxe,
+  because that is what installs the IRQ exception handler and the interrupt
+  protocol, and before TimerDxe, because the virtual timer PPI has to be free.
+
+  Design rules:
+
+    * Every wait is bounded.  A self-test that can hang is worse than no test.
+    * Every check prints and continues.  This runs before there is any way to
+      diagnose a stop.
+    * A deviation is reported as GAP, not FAIL.  Some properties are knowingly
+      unimplemented in the hypervisor today; the point is to measure them on
+      hardware rather than to assert them from a code read.
+    * The driver restores every register it writes.  It is a test, not a
+      configuration.
+    * It only touches registers the vGIC models.  An unmodelled redistributor
+      register is a fatal guest abort in this hypervisor (the distributor
+      tolerates unknown offsets, the redistributor does not), so probing one
+      would turn a conformance test into a boot stop.  That asymmetry is
+      reported in docs/vgic-selftest.md rather than exercised here.
+
+  Copyright (c) 2026, SiliconCamp contributors. All rights reserved.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+
+**/
+
+#include <Uefi.h>
+
+#include <Library/ArmLib.h>
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/DebugLib.h>
+#include <Library/IoLib.h>
+#include <Library/PcdLib.h>
+#include <Library/PrintLib.h>
+#include <Library/TimerLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiDriverEntryPoint.h>
+
+#include <Protocol/Cpu.h>
+#include <Protocol/HardwareInterrupt.h>
