+}
+
+STATIC
+VOID
+IccSgi1r (
+  IN UINT64  Value
+  )
+{
+  __asm__ volatile ("msr S3_0_C12_C11_5, %0" :: "r" (Value) : "memory");
+}
+
+STATIC
+VOID
+CntvSetCtl (
+  IN UINT64  Value
+  )
+{
+  __asm__ volatile ("msr S3_3_C14_C3_1, %0" :: "r" (Value) : "memory");
+}
+
