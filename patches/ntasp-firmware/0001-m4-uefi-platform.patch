index 0000000..9f00724
--- /dev/null
+++ b/Silicon/Apple/T8132FamilyPkg/T8132FamilyPkg.dsc.inc
@@ -0,0 +1,138 @@
+# T8132 SoC family DSC include file
+#  Copyright (c) 2011-2015, ARM Limited. All rights reserved.
+#  Copyright (c) 2014, Linaro Limited. All rights reserved.
+#  Copyright (c) 2015 - 2016, Intel Corporation. All rights reserved.
+#  Copyright (c) 2018 - 2019, Bingxing Wang. All rights reserved.
+#
+#  This program and the accompanying materials
+#  are licensed and made available under the terms and conditions of the BSD License
+#  which accompanies this distribution.  The full text of the license may be found at
+#  http://opensource.org/licenses/bsd-license.php
+#
+#  THE PROGRAM IS DISTRIBUTED UNDER THE BSD LICENSE ON AN "AS IS" BASIS,
+#  WITHOUT WARRANTIES OR REPRESENTATIONS OF ANY KIND, EITHER EXPRESS OR IMPLIED.
+#
+#
+# SPDX-License-Identifier: BSD-2-Clause OR MIT
+
+
+[PcdsPatchableInModule.common]
+  # These defaults are patched from the Apple boot_args by PrePi's
+  # DiscoverDramFromDt.  The Mac16,3 (J624) iMac has 24GB of DRAM at the
+  # 1TB boot alias (chosen/dram-base = 0x10000000000, dram-size = 0x600000000).
+  gArmTokenSpaceGuid.PcdSystemMemoryBase|0x10000000000
+  gArmTokenSpaceGuid.PcdSystemMemorySize|0x600000000 #24GB, Mac16,3
+  gArmTokenSpaceGuid.PcdFdBaseAddress|0x0
+  gArmTokenSpaceGuid.PcdFvBaseAddress|0x0
+  gAppleSiliconPkgTokenSpaceGuid.PcdFrameBufferAddress|0x0
+  gAppleSiliconPkgTokenSpaceGuid.PcdFrameBufferSize|0x0
+
+[PcdsFixedAtBuild.common]
+  #ARM architectural fixed build-time settings
+  # Setting timer frequency to 0 means "read from CNTFRQ_EL0"
+  #gArmTokenSpaceGuid.PcdArmArchTimerFreqInHz|0
+  #gArmTokenSpaceGuid.PcdCpuVectorBaseAddress|0x100FF000000 #fair warning this location is *totally random*
+  gArmTokenSpaceGuid.PcdArmArchTimerSecIntrNum|19 # placeholder 
+  gArmTokenSpaceGuid.PcdArmArchTimerIntrNum|17 # phys timer IRQ number (this is arbitrary because per-cpu fiq)
+  gArmTokenSpaceGuid.PcdArmArchTimerHypIntrNum|20 #this disables the HV timer
+  gArmTokenSpaceGuid.PcdArmArchTimerVirtIntrNum|18 #virt timer
+  gAppleSiliconPkgTokenSpaceGuid.PcdAppleUartBase|0x3ad200000
+  gAppleSiliconPkgTokenSpaceGuid.PcdAppleSocIdentifier|0x8132
+  gAppleSiliconPkgTokenSpaceGuid.PcdInitializeRamdisk|TRUE
+  gAppleSiliconPkgTokenSpaceGuid.PcdSmbiosCpuIdentifier|"T8132"
+  gAppleSiliconPkgTokenSpaceGuid.PcdSmbiosCpuModel|"Apple M4 (Donan)"
+  gAppleSiliconPkgTokenSpaceGuid.PcdSecPhaseStackBase|0x10300000000
+  gAppleSiliconPkgTokenSpaceGuid.PcdAppleSartVersion|4
+  gAppleSiliconPkgTokenSpaceGuid.PcdXhciPcieDeviceNumber|3
+  # M4 base (Mac16,3 / J624): 6 E-cores + 4 P-cores, one die, two clusters.
+  # M4 Pro/Max variants need their own platform packages and cluster counts.
+  gAppleSiliconPkgTokenSpaceGuid.PcdCoreCount|10|UINT32|0x00004406
+  gAppleSiliconPkgTokenSpaceGuid.PcdClusterCount|2|UINT32|0x00004407
+  # These live in the 1TB DRAM alias, 8.5GB above its base, and are inside
+  # the Mac16,3 24GB window.  PrePi copies boot_args and the ADT here before
+  # UEFI installs its own page tables.
+  gAppleSiliconPkgTokenSpaceGuid.PcdBootArgsPointer|0x10220000000
+  gAppleSiliconPkgTokenSpaceGuid.PcdAdtPointer|0x10220004000
+#AIC/GIC configuration settings
+!if $(AIC_BUILD) == FALSE
+  #
+  # if GIC is used, it's expected to be virtualized by EL2 at the below addresses 
+  # as Donan/T8132 has no onboard GIC. (but does contain the MSRs to do accelerated virt)
+  #
+  gArmTokenSpaceGuid.PcdGicDistributorBase|0x5000000000
+  gArmTokenSpaceGuid.PcdGicRedistributorsBase|0x5100000000
+!endif
+  gEfiMdeModulePkgTokenSpaceGuid.PcdAcpiDefaultOemRevision|0x00008132
+
+!if $(SECURE_BOOT_ENABLE) == TRUE
+  gEmbeddedTokenSpaceGuid.PcdMemoryTypeEfiRuntimeServicesData|600
+  gEmbeddedTokenSpaceGuid.PcdMemoryTypeEfiRuntimeServicesCode|400
+  gEmbeddedTokenSpaceGuid.PcdMemoryTypeEfiBootServicesCode|1500
+!else
+  gEmbeddedTokenSpaceGuid.PcdMemoryTypeEfiRuntimeServicesData|300
+  gEmbeddedTokenSpaceGuid.PcdMemoryTypeEfiRuntimeServicesCode|150
+  gEmbeddedTokenSpaceGuid.PcdMemoryTypeEfiBootServicesCode|1000
+!endif
+  gEmbeddedTokenSpaceGuid.PcdMemoryTypeEfiBootServicesData|800
+  gEmbeddedTokenSpaceGuid.PcdMemoryTypeEfiLoaderCode|10
+  gEmbeddedTokenSpaceGuid.PcdMemoryTypeEfiLoaderData|0
+  gEmbeddedTokenSpaceGuid.PcdPrePiCpuIoSize|40
+  
+  #PCIe settings
+  gEfiMdeModulePkgTokenSpaceGuid.PcdSrIovSupport|FALSE
+  gEfiMdeModulePkgTokenSpaceGuid.PcdAriSupport|FALSE
+  gEfiMdeModulePkgTokenSpaceGuid.PcdMrIovSupport|FALSE
+  #
+  # Host Bridge Library settings.
+  # 
+  #
+  # J624 (Mac16,3) PCIe.  These replace the T602X values the family inherited,
+  # which pointed the host bridge at 0x580000000 - an address that does not
+  # exist on this SoC.  Every value below was decoded from this machine's
+  # device tree; docs/pcie.md records the raw cells so they can be re-checked:
+  #   - APCIE ECAM 0x1cb0000000, 256 MB, bus range 0-8
+  #   - 32-bit window: bus 0x80000000 -> host 0xb80000000, 1 GB
+  #     (host offset 0xb00000000; WLAN BARs land at 0xb82000000/0xb83000000)
+  #   - prefetchable window: 0xbc0000000, 512 MB, no translation
+  #   - WLAN BARs at 0xb82000000/0xb83000000, inside the 32-bit window
+  #
+  gArmTokenSpaceGuid.PcdPciBusMin|0x0
+  gArmTokenSpaceGuid.PcdPciBusMax|0x8
+  #
+  # Apple chips don't seem to use "x86-style" I/O accesses, so use placeholder values here, and don't reference them in the host bridge driver.
+  #
+  gArmTokenSpaceGuid.PcdPciIoBase|0x0
+  gArmTokenSpaceGuid.PcdPciIoSize|0x00010000
+  #
+  # The 32 bit PCIe MMIO is not prefetchable.  The DT ranges entry on this
+  # machine maps bus 0x80000000 to host 0xb80000000, so the aperture base is
+  # the bus address and the host offset is 0xb00000000.
+  # AppleSiliconPciHostBridgeLib computes Translation = -PcdPciMmio32Translation,
+  # so the PCD carries bus - host = -0xb00000000 (0xFFFFFFF500000000).
+  # Dropping one hex digit (0xb8000000) silently hands devices BARs that nothing
+  # decodes; docs/pcie.md's raw cells are the source of truth.
+  #
+  gArmTokenSpaceGuid.PcdPciMmio32Base|0x80000000
+  gArmTokenSpaceGuid.PcdPciMmio32Size|0x40000000
+  gEfiMdePkgTokenSpaceGuid.PcdPciMmio32Translation|0xFFFFFFF500000000
+  gEfiMdePkgTokenSpaceGuid.PcdPciMmio64Translation|0x0
+  #
+  # 64 bit PCIe MMIO *is* prefetchable; this window is not translated.
+  #
+  gArmTokenSpaceGuid.PcdPciMmio64Base|0xBC0000000
+  gArmTokenSpaceGuid.PcdPciMmio64Size|0x20000000
+
+  gEfiMdePkgTokenSpaceGuid.PcdPciExpressBaseAddress|0x1CB0000000
+  #
+  # This shouldn't get used.
+  #
+  gEfiMdePkgTokenSpaceGuid.PcdPciIoTranslation|0x0
+
+
+[LibraryClasses.common]
+  MemoryInitPeiLib|T8132FamilyPkg/Library/MemoryInitPeiLib/MemoryInitPeiLib.inf
+  MsPlatformDevicesLib  |T8132FamilyPkg/Library/MsPlatformDevicesLib/MsPlatformDevicesLib.inf
+
+[Components.common]
+
+  T8132FamilyPkg/AcpiTables/CPUAcpiTables.inf
