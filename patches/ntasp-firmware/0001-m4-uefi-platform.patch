index 0000000..c682d70
--- /dev/null
+++ b/Silicon/Apple/AppleSiliconPkg/Drivers/AppleNANDStorageDxe/AppleNandStorage.h
@@ -0,0 +1,550 @@
+/**
+ * Copyright (c) 2023, amarioguy (AppleWOA authors). All rights reserved.
+ *
+ * Module Name:
+ *   AppleNandStorage.h
+ *
+ * Abstract:
+ *   Types and register definitions for the Apple ANS/ANS2 non-volatile storage
+ *   controller.  The ANS is not a PCIe NVMe device: it is a coprocessor (ASC
+ *   + RTKit firmware) with an NVMe engine behind Apple's own NVMMU, so the
+ *   bring-up order is ASC mailbox -> SART -> RTKit handshake -> NVMMU/NVMe
+ *   queues -> Identify -> BlockIo.
+ *
+ *   The register-level sequence is a port of m1n1's nvme.c, asc.c, sart.c and
+ *   rtkit.c (GPL-2.0-or-later / MIT), which is the only implementation of this
+ *   controller outside Apple's own operating systems.
+ *
+ * Environment:
+ *   UEFI DXE (Driver Execution Environment).
+ *
+ * License:
+ *   SPDX-License-Identifier: BSD-2-Clause-Patent OR MIT
+ *
+ **/
+
+#ifndef APPLE_NAND_STORAGE_H
+#define APPLE_NAND_STORAGE_H
+
+#include <Uefi.h>
+#include <Protocol/BlockIo.h>
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/DebugLib.h>
+#include <Library/IoLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiLib.h>
+#include <Library/AppleDTLib.h>
+
+//
+// Field helpers.  BitFieldRead* comes from BaseLib; keeping the bit positions
+// explicit (rather than GENMASK/FIELD_PREP) makes them checkable against
+// m1n1's sources by eye and by scripts/check-ans2-constants.py.
+//
+#define ANS_FIELD_GET(Value, Start, End)  BitFieldRead64 ((UINT64)(Value), (Start), (End))
+#define ANS_FIELD_PREP(Value, Start)      LShiftU64 ((UINT64)(Value), (Start))
+
+//
+// ---------------------------------------------------------------------------
+// ASC (Apple Storage Coprocessor) mailboxes.  Two FIFOs: A2I (AP to IOP) and
+// I2A (IOP to AP).  Each side publishes {u64 msg0, u32 msg1} where msg1 is the
+// RTKit endpoint the message is addressed to.
+// ---------------------------------------------------------------------------
+//
+#define ASC_CPU_CONTROL        0x44
+#define ASC_CPU_CONTROL_START  0x10
+
+#define ASC_MBOX_A2I_CONTROL  0x110
+#define ASC_MBOX_A2I_SEND0    0x800
+#define ASC_MBOX_A2I_SEND1    0x808
+
+#define ASC_MBOX_I2A_CONTROL  0x114
+#define ASC_MBOX_I2A_RECV0    0x830
+#define ASC_MBOX_I2A_RECV1    0x838
+
+#define ASC_MBOX_CONTROL_FULL   BIT16
+#define ASC_MBOX_CONTROL_EMPTY  BIT17
+
+//
+// The mailbox register block starts 0x8000 above the ASC node's reg[0]; the
+// CPU control word is at reg[0] itself.
+//
+#define ASC_MAILBOX_OFFSET  0x8000
+
+typedef struct {
+  UINT64    Msg0;
+  UINT32    Msg1;
+} APPLE_ASC_MESSAGE;
+
+typedef struct {
+  UINTN        CpuBase;
+  UINTN        Base;
+  dt_node_t    *AnsNode;
+  dt_node_t    *IopNode;
+} APPLE_ASC_DEV;
+
+EFI_STATUS
+AppleAscInit (
+  IN  dt_node_t      *AnsNode,
+  OUT APPLE_ASC_DEV  *Asc
+  );
+
+VOID
+AppleAscCpuStart (
+  IN APPLE_ASC_DEV  *Asc
+  );
+
+VOID
+AppleAscCpuStop (
+  IN APPLE_ASC_DEV  *Asc
+  );
+
+BOOLEAN
+AppleAscCpuRunning (
+  IN APPLE_ASC_DEV  *Asc
+  );
+
+BOOLEAN
+AppleAscCanSend (
+  IN APPLE_ASC_DEV  *Asc
+  );
+
+BOOLEAN
+AppleAscCanRecv (
+  IN APPLE_ASC_DEV  *Asc
+  );
+
+BOOLEAN
+AppleAscSend (
+  IN APPLE_ASC_DEV          *Asc,
+  IN CONST APPLE_ASC_MESSAGE *Msg
+  );
+
+BOOLEAN
+AppleAscRecv (
+  IN  APPLE_ASC_DEV    *Asc,
+  OUT APPLE_ASC_MESSAGE *Msg
+  );
+
+BOOLEAN
+AppleAscRecvTimeout (
+  IN  APPLE_ASC_DEV     *Asc,
+  OUT APPLE_ASC_MESSAGE *Msg,
+  IN  UINT32            DelayUsec
+  );
+
+VOID
+AppleAscDrain (
+  IN APPLE_ASC_DEV  *Asc
+  );
+
+//
+// ---------------------------------------------------------------------------
+// SART (System Address Resolution Table).  A 16-entry window table that limits
+// which DRAM the coprocessor (not the NVMe engine) may touch.  Four register
+// layouts exist; the ADT's "sart-version" selects one.
+// ---------------------------------------------------------------------------
+//
+#define APPLE_SART_MAX_ENTRIES  16
+
+#define APPLE_SART0_CONFIG_OFFSET       0x00
+#define APPLE_SART0_PADDR_OFFSET        0x40
+#define APPLE_SART2_CONFIG_OFFSET       0x00
+#define APPLE_SART2_PADDR_OFFSET        0x40
+#define APPLE_SART3_CONFIG_OFFSET       0x00
+#define APPLE_SART3_PADDR_OFFSET        0x40
+#define APPLE_SART3_SIZE_OFFSET         0x80
+#define APPLE_SART4_CONFIG_OFFSET       0x00
+#define APPLE_SART4_PADDR_OFFSET        0x60
+#define APPLE_SART4_SIZE_OFFSET         0xc0
+
+#define APPLE_SART0_CONFIG_FLAGS_START  24
+#define APPLE_SART0_CONFIG_FLAGS_END    28
+#define APPLE_SART0_CONFIG_SIZE_START   0
+#define APPLE_SART0_CONFIG_SIZE_END     18
+#define APPLE_SART0_SIZE_SHIFT          12
+#define APPLE_SART0_PADDR_SHIFT         12
+#define APPLE_SART0_FLAGS_ALLOW         0xf
+
+#define APPLE_SART2_CONFIG_FLAGS_START  24
+#define APPLE_SART2_CONFIG_FLAGS_END    31
+#define APPLE_SART2_CONFIG_SIZE_START   0
+#define APPLE_SART2_CONFIG_SIZE_END     23
+#define APPLE_SART2_SIZE_SHIFT          12
+#define APPLE_SART2_PADDR_SHIFT         12
+#define APPLE_SART2_FLAGS_ALLOW         0xff
+
+#define APPLE_SART3_SIZE_START  0
+#define APPLE_SART3_SIZE_END    29
+#define APPLE_SART3_SIZE_SHIFT  12
+#define APPLE_SART3_PADDR_SHIFT 12
+#define APPLE_SART3_FLAGS_ALLOW 0xff
+
+#define APPLE_SART4_SIZE_START  0
+#define APPLE_SART4_SIZE_END    29
+#define APPLE_SART4_SIZE_SHIFT  12
+#define APPLE_SART4_PADDR_SHIFT 12
+#define APPLE_SART4_FLAGS_ALLOW 0xff
+
+typedef struct _APPLE_SART_DEV APPLE_SART_DEV;
+
+struct _APPLE_SART_DEV {
+  UINTN      Base;
+  UINT32     Version;
+  UINT32     ProtectedEntries;
+  UINT32     FlagsAllow;
+  UINT32     ConfigOffset;
+  UINT32     PaddrOffset;
+  UINT32     SizeOffset;
+
+  VOID
+  (*GetEntry) (
+    IN  APPLE_SART_DEV  *Sart,
+    IN  UINT32          Index,
+    OUT UINT8           *Flags,
+    OUT UINT64          *Paddr,
+    OUT UINT64          *Size
+    );
+
+  BOOLEAN
+  (*SetEntry) (
+    IN APPLE_SART_DEV  *Sart,
+    IN UINT32          Index,
+    IN UINT8           Flags,
+    IN UINT64          Paddr,
+    IN UINT64          Size
+    );
+};
+
+EFI_STATUS
+AppleSartInit (
+  IN  dt_node_t       *SartNode,
+  OUT APPLE_SART_DEV  *Sart
+  );
+
+BOOLEAN
+AppleSartAddAllowedRegion (
+  IN APPLE_SART_DEV  *Sart,
+  IN UINT64          Paddr,
+  IN UINT64          Size
+  );
+
+BOOLEAN
+AppleSartRemoveAllowedRegion (
+  IN APPLE_SART_DEV  *Sart,
+  IN UINT64          Paddr,
+  IN UINT64          Size
+  );
+
+//
+// ---------------------------------------------------------------------------
+// RTKit.  The coprocessor firmware is an RTKit IOP: a small message protocol
+// runs before any NVMe register is touched.  Endpoints 0-0x1f are the
+// firmware's own (management, crashlog, syslog, ioreport, oslog); the driver
+// must answer buffer requests and ACK syslog entries or the IOP stops.
+// ---------------------------------------------------------------------------
+//
+#define RTKIT_EP_MGMT      0
+#define RTKIT_EP_CRASHLOG  1
+#define RTKIT_EP_SYSLOG    2
+#define RTKIT_EP_DEBUG     3
+#define RTKIT_EP_IOREPORT  4
+#define RTKIT_EP_OSLOG     8
+
+#define RTKIT_MGMT_TYPE_START  52
+#define RTKIT_MGMT_TYPE_END    59
+
+#define RTKIT_MGMT_PWR_STATE_START  0
+#define RTKIT_MGMT_PWR_STATE_END    15
+
+#define RTKIT_MSG_BUFFER_REQUEST        1
+#define RTKIT_MSG_BUFFER_REQUEST_SIZE_START  44
+#define RTKIT_MSG_BUFFER_REQUEST_SIZE_END    51
+#define RTKIT_MSG_BUFFER_REQUEST_IOVA_START  0
+#define RTKIT_MSG_BUFFER_REQUEST_IOVA_END    41
+
+#define RTKIT_MSG_SYSLOG_INIT            8
+#define RTKIT_MSG_SYSLOG_INIT_SIZE_START 24
+#define RTKIT_MSG_SYSLOG_INIT_SIZE_END   39
+#define RTKIT_MSG_SYSLOG_INIT_COUNT_START  0
+#define RTKIT_MSG_SYSLOG_INIT_COUNT_END    15
+#define RTKIT_MSG_SYSLOG_LOG             5
+#define RTKIT_MSG_SYSLOG_LOG_INDEX_START 0
+#define RTKIT_MSG_SYSLOG_LOG_INDEX_END   7
+
+#define RTKIT_MSG_OSLOG_INIT  0x10
+#define RTKIT_MSG_OSLOG_ACK   0x30
+
+#define RTKIT_MGMT_MSG_HELLO        1
+#define RTKIT_MGMT_MSG_HELLO_ACK    2
+#define RTKIT_MGMT_MSG_HELLO_MINVER_START  0
+#define RTKIT_MGMT_MSG_HELLO_MINVER_END    15
+#define RTKIT_MGMT_MSG_HELLO_MAXVER_START  16
+#define RTKIT_MGMT_MSG_HELLO_MAXVER_END    31
+
+#define RTKIT_MGMT_MSG_IOP_PWR_STATE      6
+#define RTKIT_MGMT_MSG_IOP_PWR_STATE_ACK  7
+
+#define RTKIT_MGMT_MSG_EPMAP            8
+#define RTKIT_MGMT_MSG_EPMAP_DONE_BIT   51
+#define RTKIT_MGMT_MSG_EPMAP_BASE_START 32
+#define RTKIT_MGMT_MSG_EPMAP_BASE_END   34
+#define RTKIT_MGMT_MSG_EPMAP_BITMAP_START  0
+#define RTKIT_MGMT_MSG_EPMAP_BITMAP_END    31
+
+#define RTKIT_MGMT_MSG_EPMAP_REPLY       8
+#define RTKIT_MGMT_MSG_EPMAP_REPLY_DONE_BIT  51
+#define RTKIT_MGMT_MSG_EPMAP_REPLY_MORE_BIT  0
+
+#define RTKIT_MGMT_MSG_AP_PWR_STATE      0xb
+#define RTKIT_MGMT_MSG_AP_PWR_STATE_ACK  0xb
+
+#define RTKIT_MGMT_MSG_START_EP        5
+#define RTKIT_MGMT_MSG_START_EP_IDX_START  32
+#define RTKIT_MGMT_MSG_START_EP_IDX_END    39
+#define RTKIT_MGMT_MSG_START_EP_FLAG_BIT   1
+
+#define RTKIT_MIN_VERSION  11
+#define RTKIT_MAX_VERSION  12
+
+#define RTKIT_POWER_OFF       0x00
+#define RTKIT_POWER_SLEEP     0x01
+#define RTKIT_POWER_QUIESCED  0x10
+#define RTKIT_POWER_ON        0x20
+#define RTKIT_POWER_INIT      0x220
+
+#define RTKIT_SYSLOG_HDR_SIZE  32
+#define RTKIT_SYSLOG_MSG_MAX   256
+
+typedef struct {
+  UINT8     Ep;
+  UINT64    Msg;
+} APPLE_RTKIT_MESSAGE;
+
+typedef struct {
+  UINT64    Phys;
+  UINT64    Dva;
+  UINT64    Size;
+  BOOLEAN   Allocated;
+} APPLE_RTKIT_BUFFER;
+
+typedef struct {
+  CONST CHAR8      *Name;
+  APPLE_ASC_DEV    Asc;
+  APPLE_SART_DEV   Sart;
+  BOOLEAN          HasSart;
+
+  UINT64           DvaBase;
+
+  UINT32           IopPower;
+  UINT32           ApPower;
+
+  APPLE_RTKIT_BUFFER  Syslog;
+  APPLE_RTKIT_BUFFER  Crashlog;
+  APPLE_RTKIT_BUFFER  Ioreport;
+
+  UINT32           SyslogCount;
+  UINT32           SyslogEntrySize;
+
+  BOOLEAN          Crashed;
+  BOOLEAN          Booted;
+} APPLE_RTKIT_DEV;
+
+EFI_STATUS
+AppleRtkitInit (
+  IN  CONST CHAR8     *Name,
+  IN  APPLE_ASC_DEV   *Asc,
+  IN  APPLE_SART_DEV  *Sart,      OPTIONAL
+  OUT APPLE_RTKIT_DEV *Rtk
+  );
+
+EFI_STATUS
+AppleRtkitBoot (
+  IN OUT APPLE_RTKIT_DEV  *Rtk
+  );
+
+EFI_STATUS
+AppleRtkitQuiesce (
+  IN OUT APPLE_RTKIT_DEV  *Rtk
+  );
+
+EFI_STATUS
+AppleRtkitSleep (
+  IN OUT APPLE_RTKIT_DEV  *Rtk
+  );
+
+VOID
+AppleRtkitFree (
+  IN OUT APPLE_RTKIT_DEV  *Rtk
+  );
