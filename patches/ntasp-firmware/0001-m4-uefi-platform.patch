+//
+// --------------------------------------------------------------------------
+// Data path.
+// --------------------------------------------------------------------------
+//
+
+STATIC
+EFI_STATUS
+AnsIdentify (
+  IN UINT32  Cns,
+  IN UINT32  Nsid,
+  IN VOID    *Buffer
+  )
+{
+  APPLE_NVME_COMMAND  Command;
+
+  ZeroMem (&Command, sizeof (Command));
+  Command.Opcode = NVME_ADMIN_CMD_IDENTIFY;
+  Command.Nsid   = Nsid;
+  Command.Prp1   = (UINT64)(UINTN)Buffer;
+  Command.Cdw10  = Cns;
+
+  return AnsExecuteCommand (&mAns.AdminQueue, &Command, NULL);
+}
+
+STATIC
+VOID
+AnsLogIdentifyString (
+  IN CONST UINT8  *Identify,
+  IN UINT32       Offset,
+  IN UINT32       Length,
+  IN CONST CHAR8  *Label
+  )
+{
+  CHAR8  Value[41];
+  UINT32  Index;
+  UINT32  Used;
+
+  if (Length > 40) {
+    Length = 40;
+  }
+
+  Used = 0;
+  for (Index = 0; Index < Length; Index++) {
+    CHAR8  Character = (CHAR8)Identify[Offset + Index];
+
+    if ((Character == '\0') || (Character == ' ')) {
+      continue;
+    }
+
+    Value[Used++] = Character;
+  }
+
+  Value[Used] = '\0';
+
+  DEBUG ((DEBUG_INFO, "ans: %a '%a'\n", Label, Value));
+}
+
+STATIC
+UINT32
+AnsGetNamespaceBlockSize (
+  IN CONST APPLE_NVME_IDENTIFY_NAMESPACE  *Identify
+  )
+{
+  UINT32  FormatIndex;
+  UINT8   LbaDataSize;
+  UINT32  Shift;
+
+  FormatIndex = Identify->Flbas & 0x0f;
+  LbaDataSize = Identify->LbaFormat[FormatIndex * NVME_IDENTIFY_LBAF_STRIDE + NVME_IDENTIFY_LBAF_LBADS];
+
+  if ((LbaDataSize < 9) || (LbaDataSize > 16)) {
+    DEBUG ((DEBUG_WARN, "ans: LBA format %d has an unusable LBADS of %d\n", FormatIndex, LbaDataSize));
+    return 0;
+  }
+
+  Shift = LbaDataSize;
+  return (UINT32)LShiftU64 (1, Shift);
+}
+
+//
+// One command per block through the bounce buffer: every DMA address the engine
+// sees is a page-aligned page the driver allocated, and the TCB length field
+// always matches a whole number of blocks.
+//
+STATIC
+EFI_STATUS
+AnsReadWriteBlock (
+  IN BOOLEAN  Write,
+  IN UINT64   Lba,
+  IN VOID     *Buffer
+  )
+{
+  APPLE_NVME_COMMAND  Command;
+
+  ZeroMem (&Command, sizeof (Command));
+  Command.Opcode = Write ? NVME_CMD_WRITE : NVME_CMD_READ;
+  Command.Nsid   = mAns.Nsid;
+  Command.Prp1   = (UINT64)(UINTN)mAns.BounceBuffer;
+  Command.Cdw10  = (UINT32)Lba;
+  Command.Cdw11  = (UINT32)RShiftU64 (Lba, 32);
+  Command.Cdw12  = 0;                       // zero-based block count: one block
+
+  if (Write) {
+    CopyMem (mAns.BounceBuffer, Buffer, mAns.BlockSize);
+  }
+
+  if (EFI_ERROR (AnsExecuteCommand (&mAns.IoQueue, &Command, NULL))) {
+    return EFI_DEVICE_ERROR;
+  }
+
+  if (!Write) {
+    CopyMem (Buffer, mAns.BounceBuffer, mAns.BlockSize);
+  }
+
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+AnsFlush (
+  VOID
+  )
+{
+  APPLE_NVME_COMMAND  Command;
+
+  ZeroMem (&Command, sizeof (Command));
+  Command.Opcode = NVME_CMD_FLUSH;
+  Command.Nsid   = mAns.Nsid;
+
+  //
+  // No data buffer: the NVMMU TCB for this slot carries no transfer, and a
+  // flush that reports "no completion" is reported but not fatal to the caller.
+  //
+  return AnsExecuteCommand (&mAns.IoQueue, &Command, NULL);
+}
+
+//
+// --------------------------------------------------------------------------
+// EFI_BLOCK_IO_PROTOCOL.
+// --------------------------------------------------------------------------
+//
+
+STATIC
+EFI_STATUS
+EFIAPI
+AnsBlockIoReset (
+  IN EFI_BLOCK_IO_PROTOCOL  *This,
+  IN BOOLEAN                ExtendedVerification
+  )
+{
+  if (!mAns.Initialized) {
+    return EFI_DEVICE_ERROR;
+  }
+
+  //
+  // Bringing the controller back up would mean a firmware handshake; the useful
+  // part of a reset here is getting the volatile write cache to disk, and a
+  // flush that does not report completion is still worth reporting to the log.
+  //
+  if (EFI_ERROR (AnsFlush ())) {
+    DEBUG ((DEBUG_WARN, "ans: flush during reset did not complete\n"));
+  }
+
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+AnsBlockIoCheckArguments (
+  IN  EFI_BLOCK_IO_PROTOCOL  *This,
+  IN  UINT32                 MediaId,
+  IN  UINT64                 Lba,
+  IN  UINTN                  BufferSize,
+  IN  VOID                   *Buffer,
+  OUT UINT64                 *BlockCount
+  )
+{
+  EFI_BLOCK_IO_MEDIA  *Media;
+
+  Media = This->Media;
+
+  if (Buffer == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  if (MediaId != Media->MediaId) {
+    return EFI_MEDIA_CHANGED;
+  }
+
+  if (!Media->MediaPresent) {
+    return EFI_NO_MEDIA;
+  }
+
+  if (BufferSize == 0) {
+    return EFI_BAD_BUFFER_SIZE;
+  }
+
+  if ((BufferSize % Media->BlockSize) != 0) {
+    return EFI_BAD_BUFFER_SIZE;
+  }
+
+  if ((Lba > Media->LastBlock) ||
+      ((Lba + (BufferSize / Media->BlockSize) - 1) > Media->LastBlock))
+  {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  *BlockCount = BufferSize / Media->BlockSize;
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+AnsBlockIoTransfer (
+  IN BOOLEAN  Write,
+  IN UINT64   Lba,
+  IN UINTN    BlockCount,
+  IN VOID     *Buffer
+  )
+{
+  UINT8       *Cursor;
+  UINTN       Index;
+  EFI_STATUS  Status;
+
+  Cursor = (UINT8 *)Buffer;
+
+  for (Index = 0; Index < BlockCount; Index++) {
+    Status = AnsReadWriteBlock (Write, Lba + Index, Cursor);
+    if (EFI_ERROR (Status)) {
+      return Status;
+    }
+
+    Cursor += mAns.BlockSize;
+  }
+
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+AnsBlockIoReadBlocks (
+  IN EFI_BLOCK_IO_PROTOCOL  *This,
+  IN UINT32                 MediaId,
+  IN EFI_LBA                Lba,
+  IN UINTN                  BufferSize,
+  OUT VOID                  *Buffer
+  )
+{
+  EFI_STATUS  Status;
+  UINT64      BlockCount;
+
+  if (!mAns.Initialized) {
+    return EFI_DEVICE_ERROR;
+  }
+
+  BlockCount = 0;
+  Status     = AnsBlockIoCheckArguments (This, MediaId, Lba, BufferSize, Buffer, &BlockCount);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  return AnsBlockIoTransfer (FALSE, Lba, (UINTN)BlockCount, Buffer);
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+AnsBlockIoWriteBlocks (
+  IN EFI_BLOCK_IO_PROTOCOL  *This,
+  IN UINT32                 MediaId,
+  IN EFI_LBA                Lba,
+  IN UINTN                  BufferSize,
+  IN VOID                   *Buffer
+  )
+{
+  EFI_STATUS  Status;
+  UINT64      BlockCount;
+
+  if (!mAns.Initialized) {
+    return EFI_DEVICE_ERROR;
+  }
+
+  BlockCount = 0;
+  Status     = AnsBlockIoCheckArguments (This, MediaId, Lba, BufferSize, Buffer, &BlockCount);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  return AnsBlockIoTransfer (TRUE, Lba, (UINTN)BlockCount, Buffer);
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+AnsBlockIoFlushBlocks (
+  IN EFI_BLOCK_IO_PROTOCOL  *This
+  )
+{
+  if (!mAns.Initialized) {
+    return EFI_DEVICE_ERROR;
+  }
+
+  return AnsFlush ();
+}
 
 //
-// We basically need to roll our own NVMe driver here, because
-// Apple devices do not have "standard" NVMe, which is normally exposed
-// over PCIe, and Apple's implementation of NVMe (over the ANS2 controller)
-// breaks the spec in a few ways.
-//
\ No newline at end of file
+// --------------------------------------------------------------------------
+// Bring-up.
+// --------------------------------------------------------------------------
+//
+
+STATIC
+VOID
+AnsReportController (
+  IN dt_node_t  *AnsNode
+  )
+{
+  CHAR8     *Compatible;
+  uint64_t  *ClockGates;
+
+  Compatible = (CHAR8 *)dt_node_prop (AnsNode, "compatible", NULL);
+  DEBUG ((DEBUG_INFO, "ans: compatible %a\n", (Compatible != NULL) ? Compatible : "(none)"));
+
+  ClockGates = (uint64_t *)dt_node_prop (AnsNode, "clock-gates", NULL);
+  if (ClockGates != NULL) {
+    mAns.Die = (UINT32)ANS_FIELD_GET (*ClockGates, 28, 31);
+  } else {
+    DEBUG ((DEBUG_WARN, "ans: no clock-gates property; deriving the die from the base address\n"));
+    mAns.Die = (UINT32)((mAns.NvmeBase >> 37) & 3);
+  }
+
+  DEBUG ((
+    DEBUG_INFO,
+    "ans: %a layout, NVMe 0x%lx, NVMMU 0x%lx, die %d\n",
+    (mAns.Type == ANS_TYPE_T8132) ? "T8132" : "T8103",
+    (UINT64)mAns.NvmeBase,
+    (UINT64)mAns.NvmmuBase,
+    mAns.Die
+    ));
+}
+
+STATIC
+EFI_STATUS
+AnsReadNamespaces (
+  VOID
+  )
+{
+  APPLE_NVME_IDENTIFY_NAMESPACE  *Namespace;
+  UINT8                          *Controller;
+  EFI_STATUS                     Status;
+  UINT32                         BlockSize;
+
+  Namespace = (APPLE_NVME_IDENTIFY_NAMESPACE *)mAns.IdentifyBuffer;
+  ZeroMem (Namespace, mAns.BlockSize);
+
+  Status = AnsIdentify (NVME_CNS_NAMESPACE, mAns.Nsid, Namespace);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "ans: identify namespace %d failed: %r\n", mAns.Nsid, Status));
+    return Status;
+  }
+
+  BlockSize = AnsGetNamespaceBlockSize (Namespace);
+  if (BlockSize == 0) {
+    return EFI_DEVICE_ERROR;
+  }
+
+  if (Namespace->Nsze == 0) {
+    DEBUG ((DEBUG_ERROR, "ans: namespace %d reports zero blocks\n", mAns.Nsid));
+    return EFI_DEVICE_ERROR;
+  }
+
+  if ((BlockSize != NVME_DEFAULT_BLOCK_SIZE) && (BlockSize != 512)) {
+    DEBUG ((DEBUG_WARN, "ans: namespace reports %d-byte blocks\n", BlockSize));
+  }
+
+  mAns.BlockSize = BlockSize;
+  mAns.LastBlock = Namespace->Nsze - 1;
+
+  DEBUG ((
+    DEBUG_INFO,
+    "ans: namespace %d: %ld blocks of %d bytes, LBAF %d\n",
+    mAns.Nsid,
+    Namespace->Nsze,
+    mAns.BlockSize,
+    Namespace->Flbas & 0x0f
+    ));
+
+  ZeroMem (mAns.IdentifyBuffer, mAns.BlockSize);
+  Status = AnsIdentify (NVME_CNS_CONTROLLER, 0, mAns.IdentifyBuffer);
+  if (!EFI_ERROR (Status)) {
+    Controller = mAns.IdentifyBuffer;
+    AnsLogIdentifyString (Controller, NVME_ID_CTRL_MODEL_OFFSET, NVME_ID_CTRL_MODEL_LENGTH, "model");
+    AnsLogIdentifyString (Controller, NVME_ID_CTRL_SERIAL_OFFSET, NVME_ID_CTRL_SERIAL_LENGTH, "serial");
+    AnsLogIdentifyString (Controller, NVME_ID_CTRL_FIRMWARE_OFFSET, NVME_ID_CTRL_FIRMWARE_LENGTH, "firmware");
+  }
+
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+AnsInitialize (
+  VOID
+  )
+{
+  dt_node_t    *AnsNode;
+  dt_node_t    *SartNode;
+  uint64_t     NvmmuBase;
+  uint64_t     NvmeBase;
+  EFI_STATUS   Status;
+
+  AnsNode = dt_get ("/arm-io/ans");
+  if (AnsNode == NULL) {
+    DEBUG ((DEBUG_WARN, "ans: no /arm-io/ans node in the device tree; no internal storage\n"));
+    return EFI_NOT_FOUND;
+  }
+
+  //
+  // M4 and later describe the NVMe engine and the NVMMU as separate regions and
+  // add an nvme-secure-bar property; M1-M3 use reg[3] for both.
+  //
+  if (dt_node_prop (AnsNode, "nvme-secure-bar", NULL) != NULL) {
+    mAns.Type = ANS_TYPE_T8132;
+  } else {
+    mAns.Type = ANS_TYPE_T8103;
+  }
+
+  NvmmuBase = 0;
+  if (dt_node_reg (AnsNode, 3, &NvmmuBase, NULL) != 0 || NvmmuBase == 0) {
+    DEBUG ((DEBUG_ERROR, "ans: no NVMMU region (reg[3]) on the ANS node\n"));
+    return EFI_NOT_FOUND;
+  }
+
+  if (mAns.Type == ANS_TYPE_T8132) {
+    NvmeBase = 0;
+    if (dt_node_reg (AnsNode, 9, &NvmeBase, NULL) != 0 || NvmeBase == 0) {
+      DEBUG ((DEBUG_ERROR, "ans: no NVMe region (reg[9]) on the ANS node\n"));
+      return EFI_NOT_FOUND;
+    }
+  } else {
+    NvmeBase = NvmmuBase;
+  }
+
+  mAns.NvmmuBase = NvmmuBase;
+  mAns.NvmeBase  = NvmeBase;
+  mAns.Nsid      = 1;
+  mAns.BlockSize = NVME_DEFAULT_BLOCK_SIZE;
+
+  AnsReportController (AnsNode);
+
+  Status = AnsAllocateQueue (&mAns.AdminQueue, TRUE);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "ans: cannot allocate the admin queue: %r\n", Status));
+    return Status;
+  }
+
+  Status = AnsAllocateQueue (&mAns.IoQueue, FALSE);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "ans: cannot allocate the IO queue: %r\n", Status));
+    AnsFreeQueue (&mAns.AdminQueue);
+    return Status;
+  }
+
+  Status = AppleAscInit (AnsNode, &mAns.Asc);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "ans: no ASC mailbox: %r\n", Status));
+    goto Error;
+  }
+
+  SartNode = dt_get ("/arm-io/sart-ans");
+  if (SartNode == NULL) {
+    DEBUG ((DEBUG_ERROR, "ans: no /arm-io/sart-ans node; the firmware cannot be given buffers\n"));
+    Status = EFI_NOT_FOUND;
+    goto Error;
+  }
+
+  Status = AppleSartInit (SartNode, &mAns.Sart);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "ans: SART initialisation failed: %r\n", Status));
+    goto Error;
+  }
+
+  Status = AppleRtkitInit ("ans", &mAns.Asc, &mAns.Sart, &mAns.Rtkit);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "ans: RTKit context failed: %r\n", Status));
+    goto Error;
+  }
+
+  mAns.RtkitUp = TRUE;
+
+  DEBUG ((DEBUG_INFO, "ans: starting the coprocessor firmware\n"));
+  Status = AppleRtkitBoot (&mAns.Rtkit);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "ans: the coprocessor firmware did not come up: %r\n", Status));
+    goto Error;
+  }
+
+  //
+  // The firmware sets this once its NVMe engine is ready to be programmed.
+  //
+  if (!AnsWaitRegister (NVME_BOOT_STATUS, 0xffffffff, NVME_BOOT_STATUS_OK, 1000000)) {
+    DEBUG ((
+      DEBUG_ERROR,
+      "ans: boot status is 0x%x, expected 0x%x\n",
+      AnsNvmeRead32 (NVME_BOOT_STATUS),
+      NVME_BOOT_STATUS_OK
+      ));
+    Status = EFI_DEVICE_ERROR;
+    goto Error;
+  }
+
+  //
+  // Linear submission queues: the engine takes one TCB per slot instead of
+  // walking a PRP list, and the NVMMU holds the TCB arrays for both queues.
+  //
+  AnsNvmeWrite32 (NVME_LINEAR_SQ_CTRL, AnsNvmeRead32 (NVME_LINEAR_SQ_CTRL) | NVME_LINEAR_SQ_CTRL_EN);
+  AnsNvmeWrite32 (NVME_MAX_PEND_CMDS_CTRL, ((NVME_QUEUE_SIZE - 1) << 16) | (NVME_QUEUE_SIZE - 1));
+  AnsNvmmuWrite32 (NVMMU_NUM, NVME_QUEUE_SIZE - 1);
+  AnsNvmmuWrite64 (NVMMU_ASQ_BASE, (UINT64)(UINTN)mAns.AdminQueue.Tcbs);
+  AnsNvmmuWrite64 (NVMMU_IOSQ_BASE, (UINT64)(UINTN)mAns.IoQueue.Tcbs);
+
+  if (!AnsControllerDisable ()) {
+    DEBUG ((DEBUG_ERROR, "ans: the controller would not stop\n"));
+    Status = EFI_DEVICE_ERROR;
+    goto Error;
+  }
+
+  AnsNvmeWrite64 (NVME_ASQ, (UINT64)(UINTN)mAns.AdminQueue.Cmds);
+  AnsNvmeWrite64 (NVME_ACQ, (UINT64)(UINTN)mAns.AdminQueue.Cqes);
+  AnsNvmeWrite32 (NVME_AQA, ((NVME_QUEUE_SIZE - 1) << 16) | (NVME_QUEUE_SIZE - 1));
+
+  if (!AnsControllerEnable ()) {
+    DEBUG ((DEBUG_ERROR, "ans: the controller never became ready\n"));
+    Status = EFI_DEVICE_ERROR;
+    goto Error;
+  }
+
+  Status = AnsCreateIoQueues ();
+  if (EFI_ERROR (Status)) {
+    goto ErrorController;
+  }
+
+  Status = AnsReadNamespaces ();
+  if (EFI_ERROR (Status)) {
+    goto ErrorController;
+  }
+
+  mAns.BounceBuffer = AllocateAlignedPages (EFI_SIZE_TO_PAGES (mAns.BlockSize), mAns.BlockSize);
+  if (mAns.BounceBuffer == NULL) {
+    Status = EFI_OUT_OF_RESOURCES;
+    goto ErrorController;
+  }
+
+  FreeAlignedPages (mAns.IdentifyBuffer, EFI_SIZE_TO_PAGES (NVME_DEFAULT_BLOCK_SIZE));
+  mAns.IdentifyBuffer = NULL;
+
+  mAns.Initialized = TRUE;
+
+  DEBUG ((
+    DEBUG_INFO,
+    "ans: ready: %ld blocks of %d bytes (%ld MB); the controller stays enabled for the OS\n",
+    mAns.LastBlock + 1,
+    mAns.BlockSize,
+    RShiftU64 ((mAns.LastBlock + 1) * mAns.BlockSize, 20)
+    ));
+
+  return EFI_SUCCESS;
+
+ErrorController:
+  AnsControllerShutdown ();
+  AnsControllerDisable ();
+Error:
+  if (mAns.RtkitUp) {
+    AppleRtkitQuiesce (&mAns.Rtkit);
+    AppleRtkitSleep (&mAns.Rtkit);
+    AppleRtkitFree (&mAns.Rtkit);
+    mAns.RtkitUp = FALSE;
+  }
+
+  AnsFreeQueue (&mAns.IoQueue);
+  AnsFreeQueue (&mAns.AdminQueue);
+  return Status;
+}
+
+STATIC
+EFI_STATUS
+AnsInstallBlockIo (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+
+  mAns.Media.MediaId          = 1;
+  mAns.Media.RemovableMedia   = FALSE;
+  mAns.Media.MediaPresent     = TRUE;
+  mAns.Media.LogicalPartition = FALSE;
+  mAns.Media.ReadOnly         = FALSE;
+  mAns.Media.WriteCaching     = TRUE;
+  mAns.Media.BlockSize        = mAns.BlockSize;
+  mAns.Media.IoAlign          = 0;
+  mAns.Media.LastBlock        = mAns.LastBlock;
+
+  mAns.BlockIo.Revision    = EFI_BLOCK_IO_PROTOCOL_REVISION;
+  mAns.BlockIo.Media       = &mAns.Media;
+  mAns.BlockIo.Reset       = AnsBlockIoReset;
+  mAns.BlockIo.ReadBlocks  = AnsBlockIoReadBlocks;
+  mAns.BlockIo.WriteBlocks = AnsBlockIoWriteBlocks;
+  mAns.BlockIo.FlushBlocks = AnsBlockIoFlushBlocks;
+
+  mAns.Handle = NULL;
+  Status      = gBS->InstallMultipleProtocolInterfaces (
+                       &mAns.Handle,
+                       &gEfiBlockIoProtocolGuid,
+                       &mAns.BlockIo,
+                       NULL
+                       );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "ans: cannot publish the block device: %r\n", Status));
+    return Status;
+  }
+
+  DEBUG ((
+    DEBUG_INFO,
+    "ans: EFI_BLOCK_IO_PROTOCOL installed: %ld blocks x %d bytes\n",
+    mAns.LastBlock + 1,
+    mAns.BlockSize
+    ));
+
+  return EFI_SUCCESS;
+}
+
+/**
+  Entry point of the Apple NAND storage driver.
+
+  @param[in] ImageHandle  Handle of this driver image.
+  @param[in] SystemTable  Pointer to the EFI System Table.
+
+  @retval EFI_SUCCESS  The driver installed the controller, or the platform has
+                       no ANS node to drive.
+  @retval others       The controller was found but could not be brought up.
+
+**/
+EFI_STATUS
+EFIAPI
+AppleNANDStorageDxeInitialize (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_STATUS  Status;
+
+  ZeroMem (&mAns, sizeof (mAns));
+
+  mAns.IdentifyBuffer = AllocateAlignedPages (EFI_SIZE_TO_PAGES (NVME_DEFAULT_BLOCK_SIZE), NVME_DEFAULT_BLOCK_SIZE);
+  if (mAns.IdentifyBuffer == NULL) {
+    DEBUG ((DEBUG_ERROR, "ans: cannot allocate the identify buffer\n"));
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  Status = AnsInitialize ();
+  if (Status == EFI_NOT_FOUND) {
+    //
+    // Not an M4-class machine, or the tree does not describe an ANS.  That is
+    // not an error for this driver.
+    //
+    Status = EFI_SUCCESS;
+  } else if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "ans: the internal storage controller was not brought up: %r\n", Status));
+  } else {
+    Status = AnsInstallBlockIo ();
+    if (EFI_ERROR (Status)) {
+      mAns.Initialized = FALSE;
+    }
+  }
+
+  if (mAns.IdentifyBuffer != NULL) {
+    FreeAlignedPages (mAns.IdentifyBuffer, EFI_SIZE_TO_PAGES (NVME_DEFAULT_BLOCK_SIZE));
+    mAns.IdentifyBuffer = NULL;
+  }
+
+  return Status;
+}
