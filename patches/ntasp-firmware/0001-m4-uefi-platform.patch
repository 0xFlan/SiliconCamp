diff --git a/Silicon/Apple/T8132FamilyPkg/Library/MsPlatformDevicesLib/MsPlatformDevicesLib.c b/Silicon/Apple/T8132FamilyPkg/Library/MsPlatformDevicesLib/MsPlatformDevicesLib.c
