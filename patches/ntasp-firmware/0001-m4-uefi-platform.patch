+  //System DRAM
+  VirtualMemoryTable[++Index].PhysicalBase = PcdGet64(PcdSystemMemoryBase);
+  VirtualMemoryTable[Index].VirtualBase    = PcdGet64(PcdSystemMemoryBase);
