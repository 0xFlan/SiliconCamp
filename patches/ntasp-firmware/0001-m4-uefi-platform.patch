index 0000000..e9ef8a5
--- /dev/null
+++ b/Silicon/Apple/T8132FamilyPkg/Include/Library/T8132FamilyVirtualMemoryMapDefines.h
@@ -0,0 +1,176 @@
+/**
+ * @file AppleVirtualMemoryMapDefines.h
+ * @author amarioguy (Arminder Singh)
+ * 
+ * Defines used in configuring the virtual memory map for M4.
+ * 
+ * @version 0.1
+ * @date 2022-08-22
+ * 
+ * @copyright Copyright (c) amarioguy (Arminder Singh) 2022.
+ * 
+ * SPDX-License-Identiifer: BSD-2-Clause-Patent
+ * 
+ */
+
+ //
+ // Note as of 5/25/2025: this is based on the M2 Pro MBP that I have - the memory map file should be machine specific, and the driver
+ // seems like it should become general to all SoCs. Note this change for later - but leave this machine specific for right now.
+ // What I would really want is a way to generalize this based on a memory map passed in. This *seems* like it should fall to the DeviceTree...
+ // Most ranges seem to match M1 Pro series, so this should probably remain the same (M3/M4 series definitely do not keep this same mapping)
+ //
+
+#include <Base.h>
+
+#ifndef APPLE_VIRTUAL_MEMORY_MAP_DEFINES_H_
+#define APPLE_VIRTUAL_MEMORY_MAP_DEFINES_H_
+
+//"core" MMIO devices, like PMGR, AIC, USB, etc. (mappings need to be nGnRnE)
+//
+// M4/J624 keeps the USB DWC3 controllers at low physical addresses
+// (usb-drd0@0x2280000 ... usb-drd3@0x1a280000), so the low 1GB window has to
+// be mapped even though the M1/M2 map started at 0x280000000.
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_0_BASE 0x000000000
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_0_SIZE SIZE_1GB
+
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_1_BASE 0x280000000
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_1_SIZE SIZE_1GB
+
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_2_BASE 0x380000000
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_2_SIZE SIZE_1GB
+
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_3_BASE 0x580000000
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_3_SIZE SIZE_512MB
+
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_4_BASE 0x700000000
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_4_SIZE SIZE_1GB
+
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_5_BASE 0xB00000000
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_5_SIZE SIZE_1GB
+
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_6_BASE 0xF00000000
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_6_SIZE SIZE_1GB
+
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_7_BASE 0x1300000000
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_7_SIZE SIZE_1GB
+
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_8_BASE 0x2280000000
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_8_SIZE SIZE_1GB
+
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_9_BASE 0x2380000000
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_9_SIZE SIZE_1GB
+
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_10_BASE 0x2580000000
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_10_SIZE SIZE_512MB
+
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_11_BASE 0x2700000000
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_11_SIZE SIZE_1GB
+
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_12_BASE 0x2B00000000
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_12_SIZE SIZE_1GB
+
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_13_BASE 0x2F00000000
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_13_SIZE SIZE_1GB
+
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_14_BASE 0x3300000000
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_14_SIZE SIZE_1GB
+
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_15_BASE 0x5000000000
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_15_SIZE SIZE_64KB
+
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_16_BASE 0x5100000000
+#define APPLE_CORE_SYSTEM_MMIO_RANGE_16_SIZE SIZE_2MB
+
+
+
+//PCIe MMIO (mappings need to be nGnRE)
+#define APPLE_PCIE_MMIO_RANGE_1_BASE 0x5A0000000
+#define APPLE_PCIE_MMIO_RANGE_1_SIZE SIZE_512MB
+
+#define APPLE_PCIE_MMIO_RANGE_2_BASE 0x5C0000000
+#define APPLE_PCIE_MMIO_RANGE_2_SIZE SIZE_1GB
+
+#define APPLE_PCIE_MMIO_RANGE_3_BASE 0x800000000
+#define APPLE_PCIE_MMIO_RANGE_3_SIZE SIZE_8GB
+
+#define APPLE_PCIE_MMIO_RANGE_4_BASE 0xA00000000
+#define APPLE_PCIE_MMIO_RANGE_4_SIZE SIZE_2GB
+
+#define APPLE_PCIE_MMIO_RANGE_5_BASE 0xC00000000
+#define APPLE_PCIE_MMIO_RANGE_5_SIZE SIZE_8GB
+
+#define APPLE_PCIE_MMIO_RANGE_6_BASE 0xE00000000
+#define APPLE_PCIE_MMIO_RANGE_6_SIZE SIZE_2GB
+
+#define APPLE_PCIE_MMIO_RANGE_7_BASE 0x1000000000
+#define APPLE_PCIE_MMIO_RANGE_7_SIZE SIZE_8GB
+
+#define APPLE_PCIE_MMIO_RANGE_8_BASE 0x1200000000
+#define APPLE_PCIE_MMIO_RANGE_8_SIZE SIZE_2GB
+
+#define APPLE_PCIE_MMIO_RANGE_9_BASE 0x1400000000
+#define APPLE_PCIE_MMIO_RANGE_9_SIZE SIZE_8GB
+
+#define APPLE_PCIE_MMIO_RANGE_10_BASE 0x1600000000
+#define APPLE_PCIE_MMIO_RANGE_10_SIZE SIZE_2GB
+
+#define APPLE_PCIE_MMIO_RANGE_21_BASE 0x1800000000
+#define APPLE_PCIE_MMIO_RANGE_21_SIZE SIZE_16GB
+
+#define APPLE_PCIE_MMIO_RANGE_22_BASE 0x1700000000
+#define APPLE_PCIE_MMIO_RANGE_22_SIZE SIZE_4GB
+
+//
+// Should be harmless to leave these in as long as memory doesn't access it?
+// Will need to remove these later though.
+
+#define APPLE_PCIE_MMIO_RANGE_11_BASE 0x25A0000000
+#define APPLE_PCIE_MMIO_RANGE_11_SIZE SIZE_512MB
+
+#define APPLE_PCIE_MMIO_RANGE_12_BASE 0x25C0000000
+#define APPLE_PCIE_MMIO_RANGE_12_SIZE SIZE_1GB
+
+#define APPLE_PCIE_MMIO_RANGE_13_BASE 0x2800000000
+#define APPLE_PCIE_MMIO_RANGE_13_SIZE SIZE_8GB
+
+#define APPLE_PCIE_MMIO_RANGE_14_BASE 0x2A00000000
+#define APPLE_PCIE_MMIO_RANGE_14_SIZE SIZE_2GB
+
+#define APPLE_PCIE_MMIO_RANGE_15_BASE 0x2C00000000
+#define APPLE_PCIE_MMIO_RANGE_15_SIZE SIZE_8GB
+
+#define APPLE_PCIE_MMIO_RANGE_16_BASE 0x2E00000000
+#define APPLE_PCIE_MMIO_RANGE_16_SIZE SIZE_2GB
+
+#define APPLE_PCIE_MMIO_RANGE_17_BASE 0x3000000000
+#define APPLE_PCIE_MMIO_RANGE_17_SIZE SIZE_8GB
+
+#define APPLE_PCIE_MMIO_RANGE_18_BASE 0x3200000000
+#define APPLE_PCIE_MMIO_RANGE_18_SIZE SIZE_2GB
+
+#define APPLE_PCIE_MMIO_RANGE_19_BASE 0x3400000000
+#define APPLE_PCIE_MMIO_RANGE_19_SIZE SIZE_8GB
+
+#define APPLE_PCIE_MMIO_RANGE_20_BASE 0x3600000000
+#define APPLE_PCIE_MMIO_RANGE_20_SIZE SIZE_2GB
+
+
+
+//
+// J624 PCIe windows, decoded from this machine's device tree (docs/pcie.md
+// records the raw ranges cells).  The 32-bit aperture is bus 0x80000000 ->
+// host 0xb80000000, so the page tables must map the *host* addresses below
+// while PcdPciMmio32Translation tells the PCI core the bus->host offset.
+// Mapping the bus address instead leaves every BAR access faulting.  The
+// prefetchable window follows immediately after it at 0xbc0000000.
+//
+#define APPLE_PCIE_ECAM_RANGE_BASE 0x1CB0000000
+#define APPLE_PCIE_ECAM_RANGE_SIZE 0x10000000
+
+#define APPLE_PCIE_MMIO_RANGE_23_BASE 0xB80000000
+#define APPLE_PCIE_MMIO_RANGE_23_SIZE 0x40000000
+
+#define APPLE_PCIE_MMIO_RANGE_24_BASE 0xBC0000000
+#define APPLE_PCIE_MMIO_RANGE_24_SIZE 0x20000000
+
+#endif // APPLE_VIRTUAL_MEMORY_MAP_DEFINES_H_
\ No newline at end of file
diff --git a/Silicon/Apple/T8132FamilyPkg/Library/MemoryInitPeiLib/MemoryInitPeiLib.c b/Silicon/Apple/T8132FamilyPkg/Library/MemoryInitPeiLib/MemoryInitPeiLib.c
