index 0000000..61e93c0
--- /dev/null
+++ b/Silicon/Apple/AppleSiliconPkg/Drivers/AppleNANDStorageDxe/AppleRtkit.c
@@ -0,0 +1,824 @@
+/**
+ * Copyright (c) 2023, amarioguy (AppleWOA authors). All rights reserved.
+ *
+ * Module Name:
+ *   AppleRtkit.c
+ *
+ * Abstract:
+ *   RTKit IOP handshake for the ANS coprocessor.  Ported from m1n1's
+ *   src/rtkit.c, restricted to what a storage controller needs (no DART/iova
+ *   path: the ANS uses a SART, which is an identity window table).
+ *
+ *   The firmware will not touch a single NVMe register until this exchange has
+ *   happened, and it expects the driver to answer its own endpoint traffic
+ *   (buffer requests, syslog entries) while it waits - a firmware that is left
+ *   with an unanswered message stops responding entirely.
+ *
+ * Environment:
+ *   UEFI DXE (Driver Execution Environment).
+ *
+ * License:
+ *   SPDX-License-Identifier: BSD-2-Clause-Patent OR MIT
+ *
+ **/
+
+#include "AppleNandStorage.h"
+
+#define RTKIT_DEFAULT_BUFFER_SIZE  (64 * 1024)
+
+//
+// One syslog entry: {u32 hdr, u32 unk, char context[24], char msg[]}.
+//
+#define RTKIT_SYSLOG_CTX_OFFSET  8
+#define RTKIT_SYSLOG_CTX_LENGTH  24
+
+EFI_STATUS
+AppleRtkitInit (
+  IN  CONST CHAR8     *Name,
+  IN  APPLE_ASC_DEV   *Asc,
+  IN  APPLE_SART_DEV  *Sart,      OPTIONAL
+  OUT APPLE_RTKIT_DEV *Rtk
+  )
+{
+  uint64_t  *DramMask;
+
+  ZeroMem (Rtk, sizeof (*Rtk));
+
+  Rtk->Name    = Name;
+  Rtk->Asc     = *Asc;
+  if (Sart != NULL) {
+    Rtk->Sart    = *Sart;
+    Rtk->HasSart = TRUE;
+  }
+
+  Rtk->IopPower = RTKIT_POWER_OFF;
+  Rtk->ApPower  = RTKIT_POWER_OFF;
+  Rtk->DvaBase  = 0;
+
+  if (Rtk->Asc.IopNode != NULL) {
+    DramMask = (uint64_t *)dt_node_prop (Rtk->Asc.IopNode, "asc-dram-mask", NULL);
+    if (DramMask != NULL) {
+      Rtk->DvaBase = (UINT64)*DramMask;
+      DEBUG ((DEBUG_INFO, "rtkit(%a): asc-dram-mask 0x%lx\n", Name, Rtk->DvaBase));
+    }
+  }
+
+  if (!Rtk->HasSart) {
+    DEBUG ((DEBUG_WARN, "rtkit(%a): no SART; the firmware cannot be given buffers\n", Name));
+    return EFI_UNSUPPORTED;
+  }
+
+  return EFI_SUCCESS;
+}
+
+STATIC
+BOOLEAN
+AppleRtkitMapBuffer (
+  IN  APPLE_RTKIT_DEV     *Rtk,
+  OUT APPLE_RTKIT_BUFFER  *Bfr,
+  IN  UINT64              Size
+  )
+{
+  VOID    *Allocation;
+  UINT64  AlignedSize;
+
+  AlignedSize = ALIGN_VALUE (Size, 16384);
+
+  Allocation = AllocateAlignedPages (EFI_SIZE_TO_PAGES (AlignedSize), 16384);
+  if (Allocation == NULL) {
+    DEBUG ((DEBUG_ERROR, "rtkit(%a): cannot allocate 0x%lx buffer\n", Rtk->Name, Size));
+    return FALSE;
+  }
+
+  ZeroMem (Allocation, (UINTN)AlignedSize);
+
+  Bfr->Phys      = (UINT64)(UINTN)Allocation;
+  Bfr->Size      = AlignedSize;
+  Bfr->Allocated = TRUE;
+
+  if (!AppleSartAddAllowedRegion (&Rtk->Sart, Bfr->Phys, AlignedSize)) {
+    FreeAlignedPages (Allocation, EFI_SIZE_TO_PAGES (AlignedSize));
+    ZeroMem (Bfr, sizeof (*Bfr));
+    return FALSE;
+  }
+
+  Bfr->Dva = Bfr->Phys;
+
+  DEBUG ((
+    DEBUG_INFO,
+    "rtkit(%a): buffer phys 0x%lx size 0x%lx\n",
+    Rtk->Name,
+    Bfr->Phys,
+    Bfr->Size
+    ));
+
+  return TRUE;
+}
+
+STATIC
+VOID
+AppleRtkitFreeBuffer (
+  IN OUT APPLE_RTKIT_DEV     *Rtk,
+  IN OUT APPLE_RTKIT_BUFFER  *Bfr
+  )
+{
+  if (!Bfr->Allocated) {
+    ZeroMem (Bfr, sizeof (*Bfr));
+    return;
+  }
+
+  if (!AppleSartRemoveAllowedRegion (&Rtk->Sart, Bfr->Phys, Bfr->Size)) {
+    DEBUG ((DEBUG_WARN, "rtkit(%a): SART entry for 0x%lx was already gone\n", Rtk->Name, Bfr->Phys));
+  }
+
+  FreeAlignedPages ((VOID *)(UINTN)Bfr->Phys, EFI_SIZE_TO_PAGES ((UINTN)Bfr->Size));
+  ZeroMem (Bfr, sizeof (*Bfr));
+}
+
+STATIC
+BOOLEAN
+AppleRtkitHandleBufferRequest (
+  IN OUT APPLE_RTKIT_DEV     *Rtk,
+  IN     APPLE_RTKIT_MESSAGE *Msg,
+  IN OUT APPLE_RTKIT_BUFFER  *Bfr
+  )
+{
+  UINT64               Pages;
+  UINT64               Size;
+  UINT64               Addr;
+  APPLE_RTKIT_MESSAGE  Reply;
+
+  Pages = ANS_FIELD_GET (
+            Msg->Msg,
+            RTKIT_MSG_BUFFER_REQUEST_SIZE_START,
+            RTKIT_MSG_BUFFER_REQUEST_SIZE_END
+            );
+  Size = LShiftU64 (Pages, 12);
+  Addr = ANS_FIELD_GET (
+           Msg->Msg,
+           RTKIT_MSG_BUFFER_REQUEST_IOVA_START,
+           RTKIT_MSG_BUFFER_REQUEST_IOVA_END
+           );
+
+  if (Addr != 0) {
+    //
+    // The firmware is telling us it already has a buffer; with a SART the
+    // address is physical and no translation is involved.
+    //
+    Bfr->Phys      = (Addr & ~Rtk->DvaBase);
+    Bfr->Dva       = Addr;
+    Bfr->Size      = Size;
+    Bfr->Allocated = FALSE;
+    DEBUG ((DEBUG_INFO, "rtkit(%a): pre-allocated buffer (ep 0x%x, dva 0x%lx)\n", Rtk->Name, Msg->Ep, Addr));
+    return TRUE;
+  }
+
+  if (!AppleRtkitMapBuffer (Rtk, Bfr, Size)) {
+    return FALSE;
+  }
+
+  Reply.Msg  = ANS_FIELD_PREP (RTKIT_MSG_BUFFER_REQUEST, RTKIT_MGMT_TYPE_START);
+  Reply.Msg |= ANS_FIELD_PREP (Pages, RTKIT_MSG_BUFFER_REQUEST_SIZE_START);
+  Reply.Msg |= ANS_FIELD_PREP (Bfr->Dva | Rtk->DvaBase, RTKIT_MSG_BUFFER_REQUEST_IOVA_START);
+  Reply.Ep   = Msg->Ep;
+
+  if (!AppleRtkitSend (Rtk, &Reply)) {
+    DEBUG ((DEBUG_ERROR, "rtkit(%a): unable to send buffer reply\n", Rtk->Name));
+    AppleRtkitFreeBuffer (Rtk, Bfr);
+    return FALSE;
+  }
+
+  return TRUE;
+}
+
+STATIC
+VOID
+AppleRtkitPrintSyslog (
+  IN APPLE_RTKIT_DEV  *Rtk,
+  IN UINT64           Index
+  )
+{
+  UINT64  Stride;
+  UINT8   *Entry;
+  CHAR8   Context[RTKIT_SYSLOG_CTX_LENGTH + 1];
+  CHAR8   Message[RTKIT_SYSLOG_MSG_MAX + 1];
+  UINTN   MessageLength;
+
+  if ((Rtk->Syslog.Dva == 0) || (Rtk->SyslogEntrySize == 0)) {
+    return;
+  }
+
+  Stride = Rtk->SyslogEntrySize + RTKIT_SYSLOG_CTX_OFFSET + RTKIT_SYSLOG_CTX_LENGTH;
+  if ((Index + 1) * Stride > Rtk->Syslog.Size) {
+    DEBUG ((DEBUG_WARN, "rtkit(%a): syslog index %d is outside the buffer\n", Rtk->Name, Index));
+    return;
+  }
+
+  Entry = (UINT8 *)(UINTN)Rtk->Syslog.Phys + Stride * Index;
+
+  CopyMem (Context, Entry + RTKIT_SYSLOG_CTX_OFFSET, RTKIT_SYSLOG_CTX_LENGTH);
+  Context[RTKIT_SYSLOG_CTX_LENGTH] = '\0';
+
+  MessageLength = AsciiStrnLenS ((CHAR8 *)(Entry + RTKIT_SYSLOG_CTX_OFFSET + RTKIT_SYSLOG_CTX_LENGTH), Rtk->SyslogEntrySize);
+  if (MessageLength > RTKIT_SYSLOG_MSG_MAX) {
+    MessageLength = RTKIT_SYSLOG_MSG_MAX;
+  }
+
+  CopyMem (Message, Entry + RTKIT_SYSLOG_CTX_OFFSET + RTKIT_SYSLOG_CTX_LENGTH, MessageLength);
+  Message[MessageLength] = '\0';
+
+  DEBUG ((DEBUG_INFO, "rtkit(%a) syslog: [%a] %a\n", Rtk->Name, Context, Message));
+}
+
+STATIC
+VOID
+AppleRtkitPrintCrashlog (
+  IN APPLE_RTKIT_DEV  *Rtk
+  )
+{
+  UINT8   *Header;
+  UINT8   *Entry;
+  UINT32  Type;
+  UINT32  Length;
+
+  Rtk->Crashed = TRUE;
+
+  DEBUG ((DEBUG_ERROR, "rtkit(%a): IOP crashed\n", Rtk->Name));
+
+  if (Rtk->Crashlog.Phys == 0) {
+    return;
+  }
+
+  Header = (UINT8 *)(UINTN)Rtk->Crashlog.Phys;
+  Type   = ((UINT32 *)Header)[0];
+  if (Type != SIGNATURE_32 ('C', 'L', 'H', 'E')) {
+    DEBUG ((DEBUG_ERROR, "rtkit(%a): bad crashlog header 0x%x\n", Rtk->Name, Type));
+    return;
+  }
+
+  Entry = Header + 32;
+  while (((UINT32 *)Entry)[0] != SIGNATURE_32 ('C', 'L', 'H', 'E')) {
+    Type   = ((UINT32 *)Entry)[0];
+    Length = ((UINT32 *)Entry)[12];
+
+    if (Length < 16) {
+      DEBUG ((DEBUG_ERROR, "rtkit(%a): crashlog entry with length %d; stopping\n", Rtk->Name, Length));
+      break;
+    }
+
+    if (Type == SIGNATURE_32 ('C', 's', 't', 'r')) {
+      DEBUG ((DEBUG_ERROR, "rtkit(%a): crash message %d: %a\n", Rtk->Name, ((UINT32 *)Entry)[4], (CHAR8 *)(Entry + 20)));
+    } else {
+      DEBUG ((DEBUG_ERROR, "rtkit(%a): crashlog entry 0x%x\n", Rtk->Name, Type));
+    }
+
+    Entry += Length;
+  }
+}
+
+BOOLEAN
+AppleRtkitSend (
+  IN APPLE_RTKIT_DEV           *Rtk,
+  IN CONST APPLE_RTKIT_MESSAGE *Msg
+  )
+{
+  APPLE_ASC_MESSAGE  AscMsg;
+
+  AscMsg.Msg0 = Msg->Msg;
+  AscMsg.Msg1 = Msg->Ep;
+
+  return AppleAscSend (&Rtk->Asc, &AscMsg);
+}
+
+STATIC
+BOOLEAN
+AppleRtkitStartEp (
+  IN APPLE_RTKIT_DEV  *Rtk,
+  IN UINT8            Ep
+  )
+{
+  APPLE_ASC_MESSAGE  Msg;
+
+  Msg.Msg0  = ANS_FIELD_PREP (RTKIT_MGMT_MSG_START_EP, RTKIT_MGMT_TYPE_START);
+  Msg.Msg0 |= BIT1;                                            // RTKIT_MGMT_MSG_START_EP_FLAG
+  Msg.Msg0 |= ANS_FIELD_PREP (Ep, RTKIT_MGMT_MSG_START_EP_IDX_START);
+  Msg.Msg1  = RTKIT_EP_MGMT;
+
+  if (!AppleAscSend (&Rtk->Asc, &Msg)) {
+    DEBUG ((DEBUG_ERROR, "rtkit(%a): unable to start endpoint 0x%02x\n", Rtk->Name, Ep));
+    return FALSE;
+  }
+
+  return TRUE;
+}
+
+INTN
+AppleRtkitRecv (
+  IN  APPLE_RTKIT_DEV      *Rtk,
+  OUT APPLE_RTKIT_MESSAGE  *Msg
+  )
+{
+  APPLE_ASC_MESSAGE  AscMsg;
+  UINT32             MessageType;
+  BOOLEAN            Ok;
+  UINT32             Bitmap;
+  UINT32             Base;
+  UINT32             Index;
+  UINT8              EpIndex;
+
+  if (Rtk->Crashed) {
+    return -1;
+  }
+
+  while (AppleAscRecv (&Rtk->Asc, &AscMsg)) {
+    if (AscMsg.Msg1 >= 0x100) {
+      DEBUG ((DEBUG_WARN, "rtkit(%a): message for invalid endpoint 0x%x\n", Rtk->Name, AscMsg.Msg1));
+      continue;
+    }
+
+    Msg->Msg = AscMsg.Msg0;
+    Msg->Ep  = (UINT8)AscMsg.Msg1;
+
+    //
+    // Application endpoints (>= 0x20) are not part of the boot protocol; the
+    // caller gets them back and decides.
+    //
+    if (Msg->Ep >= 0x20) {
+      return 1;
+    }
+
+    MessageType = (UINT32)ANS_FIELD_GET (Msg->Msg, RTKIT_MGMT_TYPE_START, RTKIT_MGMT_TYPE_END);
+    Ok          = TRUE;
+
+    switch (Msg->Ep) {
+      case RTKIT_EP_MGMT:
+        switch (MessageType) {
+          case RTKIT_MGMT_MSG_IOP_PWR_STATE_ACK:
+            Rtk->IopPower = (UINT32)ANS_FIELD_GET (Msg->Msg, RTKIT_MGMT_PWR_STATE_START, RTKIT_MGMT_PWR_STATE_END);
+            break;
+          case RTKIT_MGMT_MSG_AP_PWR_STATE_ACK:
+            Rtk->ApPower = (UINT32)ANS_FIELD_GET (Msg->Msg, RTKIT_MGMT_PWR_STATE_START, RTKIT_MGMT_PWR_STATE_END);
+            break;
+          case RTKIT_MGMT_MSG_EPMAP:
+            Bitmap = (UINT32)ANS_FIELD_GET (Msg->Msg, RTKIT_MGMT_MSG_EPMAP_BITMAP_START, RTKIT_MGMT_MSG_EPMAP_BITMAP_END);
+            Base   = (UINT32)ANS_FIELD_GET (Msg->Msg, RTKIT_MGMT_MSG_EPMAP_BASE_START, RTKIT_MGMT_MSG_EPMAP_BASE_END);
+
+            for (Index = 0; Index < 32; Index++) {
+              if ((Bitmap & (1U << Index)) == 0) {
+                continue;
+              }
+
+              EpIndex = (UINT8)(32 * Base + Index);
+              if (EpIndex >= 0x20) {
+                continue;
+              }
+
+              switch (EpIndex) {
+                case RTKIT_EP_MGMT:
+                case RTKIT_EP_CRASHLOG:
+                case RTKIT_EP_SYSLOG:
+                case RTKIT_EP_DEBUG:
+                case RTKIT_EP_IOREPORT:
+                case RTKIT_EP_OSLOG:
+                  DEBUG ((DEBUG_INFO, "rtkit(%a): endpoint 0x%02x advertised\n", Rtk->Name, EpIndex));
+                  break;
+                default:
+                  DEBUG ((DEBUG_WARN, "rtkit(%a): unknown system endpoint 0x%02x\n", Rtk->Name, EpIndex));
+              }
+            }
+
+            AscMsg.Msg0  = ANS_FIELD_PREP (RTKIT_MGMT_MSG_EPMAP_REPLY, RTKIT_MGMT_TYPE_START);
+            AscMsg.Msg0 |= ANS_FIELD_PREP (Base, RTKIT_MGMT_MSG_EPMAP_BASE_START);
+            if ((Msg->Msg & BIT51) != 0) {
+              AscMsg.Msg0 |= BIT51;     // RTKIT_MGMT_MSG_EPMAP_REPLY_DONE
+            } else {
+              AscMsg.Msg0 |= BIT0;      // RTKIT_MGMT_MSG_EPMAP_REPLY_MORE
+            }
+
+            AscMsg.Msg1 = RTKIT_EP_MGMT;
+            if (!AppleAscSend (&Rtk->Asc, &AscMsg)) {
+              DEBUG ((DEBUG_ERROR, "rtkit(%a): couldn't reply to the endpoint map\n", Rtk->Name));
+              return -1;
+            }
+
+            break;
+          default:
+            DEBUG ((DEBUG_WARN, "rtkit(%a): unknown management message 0x%x\n", Rtk->Name, MessageType));
+            break;
+        }
+
+        break;
+
+      case RTKIT_EP_SYSLOG:
+        switch (MessageType) {
+          case RTKIT_MSG_BUFFER_REQUEST:
+            Ok = AppleRtkitHandleBufferRequest (Rtk, Msg, &Rtk->Syslog);
+            break;
+          case RTKIT_MSG_SYSLOG_INIT:
+            Rtk->SyslogCount     = (UINT32)ANS_FIELD_GET (Msg->Msg, RTKIT_MSG_SYSLOG_INIT_COUNT_START, RTKIT_MSG_SYSLOG_INIT_COUNT_END);
+            Rtk->SyslogEntrySize = (UINT32)ANS_FIELD_GET (Msg->Msg, RTKIT_MSG_SYSLOG_INIT_SIZE_START, RTKIT_MSG_SYSLOG_INIT_SIZE_END);
+            DEBUG ((
+              DEBUG_INFO,
+              "rtkit(%a): syslog with %d entries of %d bytes\n",
+              Rtk->Name,
+              Rtk->SyslogCount,
+              Rtk->SyslogEntrySize
+              ));
+            break;
+          case RTKIT_MSG_SYSLOG_LOG:
+            AppleRtkitPrintSyslog (
+              Rtk,
+              ANS_FIELD_GET (Msg->Msg, RTKIT_MSG_SYSLOG_LOG_INDEX_START, RTKIT_MSG_SYSLOG_LOG_INDEX_END)
+              );
+            if (!AppleAscSend (&Rtk->Asc, &AscMsg)) {
+              DEBUG ((DEBUG_ERROR, "rtkit(%a): failed to ACK a syslog entry\n", Rtk->Name));
+            }
+
+            break;
+          default:
+            DEBUG ((DEBUG_WARN, "rtkit(%a): unknown syslog message 0x%x\n", Rtk->Name, MessageType));
+            break;
+        }
+
+        break;
+
+      case RTKIT_EP_CRASHLOG:
+        switch (MessageType) {
+          case RTKIT_MSG_BUFFER_REQUEST:
+            if (Rtk->Crashlog.Phys == 0) {
+              Ok = AppleRtkitHandleBufferRequest (Rtk, Msg, &Rtk->Crashlog);
+            } else {
+              AppleRtkitPrintCrashlog (Rtk);
+              return -1;
+            }
+
+            break;
+          default:
+            DEBUG ((DEBUG_WARN, "rtkit(%a): unknown crashlog message 0x%x\n", Rtk->Name, MessageType));
+            break;
+        }
+
+        break;
+
+      case RTKIT_EP_IOREPORT:
+        switch (MessageType) {
+          case RTKIT_MSG_BUFFER_REQUEST:
+            Ok = AppleRtkitHandleBufferRequest (Rtk, Msg, &Rtk->Ioreport);
+            break;
+          case 0x8:
+          case 0xc:
+            //
+            // Unknown, but the firmware waits for the echo.
+            //
+            if (!AppleRtkitSend (Rtk, Msg)) {
+              DEBUG ((DEBUG_WARN, "rtkit(%a): unable to ACK an ioreport message\n", Rtk->Name));
+            }
+
+            break;
+          default:
+            DEBUG ((DEBUG_WARN, "rtkit(%a): unknown ioreport message 0x%x\n", Rtk->Name, MessageType));
+            break;
+        }
+
+        break;
+
+      case RTKIT_EP_DEBUG:
+        break;
+
+      case RTKIT_EP_OSLOG:
+        DEBUG ((DEBUG_WARN, "rtkit(%a): OSLog message 0x%lx\n", Rtk->Name, Msg->Msg));
+        break;
+
+      default:
+        DEBUG ((DEBUG_WARN, "rtkit(%a): message to unknown system endpoint 0x%02x\n", Rtk->Name, Msg->Ep));
+        break;
+    }
+
+    if (!Ok) {
+      DEBUG ((DEBUG_ERROR, "rtkit(%a): failed to handle system message 0x%02x: 0x%lx\n", Rtk->Name, Msg->Ep, Msg->Msg));
+      return -1;
+    }
+  }
+
+  return 0;
+}
+
+EFI_STATUS
+AppleRtkitBoot (
+  IN OUT APPLE_RTKIT_DEV  *Rtk
+  )
+{
+  APPLE_ASC_MESSAGE    Msg;
+  APPLE_RTKIT_MESSAGE  RtkMsg;
+  UINT32               MessageType;
+  UINT32               MinVersion;
+  UINT32               MaxVersion;
+  UINT32               WantVersion;
+  UINT32               Bitmap;
+  UINT32               Base;
+  UINT32               Index;
+  UINT8                EpIndex;
+  BOOLEAN              HasCrashlog;
+  BOOLEAN              HasDebug;
+  BOOLEAN              HasIoreport;
+  BOOLEAN              HasSyslog;
+  BOOLEAN              HasOslog;
+  BOOLEAN              GotEpmap;
+  INTN                 Ret;
+  UINT32               Spin;
+
+  if (Rtk->Booted) {
+    return EFI_SUCCESS;
+  }
+
+  //
+  // Start the coprocessor if the boot chain left it stopped, then wake it.
+  // The power-state message is safe to send to a running IOP as well.
+  //
+  AppleAscCpuStart (&Rtk->Asc);
+
+  Msg.Msg0  = ANS_FIELD_PREP (RTKIT_MGMT_MSG_IOP_PWR_STATE, RTKIT_MGMT_TYPE_START);
+  Msg.Msg0 |= ANS_FIELD_PREP (RTKIT_POWER_INIT, RTKIT_MGMT_PWR_STATE_START);
+  Msg.Msg1  = RTKIT_EP_MGMT;
+  if (!AppleAscSend (&Rtk->Asc, &Msg)) {
+    DEBUG ((DEBUG_ERROR, "rtkit(%a): unable to send the wake-up message\n", Rtk->Name));
+    return EFI_DEVICE_ERROR;
+  }
+
+  if (!AppleAscRecvTimeout (&Rtk->Asc, &Msg, 1000000)) {
+    DEBUG ((DEBUG_ERROR, "rtkit(%a): no HELLO within 1s\n", Rtk->Name));
+    return EFI_TIMEOUT;
+  }
+
+  if (Msg.Msg1 != RTKIT_EP_MGMT) {
+    DEBUG ((DEBUG_ERROR, "rtkit(%a): expected HELLO, got a message for endpoint 0x%x\n", Rtk->Name, Msg.Msg1));
+    return EFI_DEVICE_ERROR;
+  }
+
+  MessageType = (UINT32)ANS_FIELD_GET (Msg.Msg0, RTKIT_MGMT_TYPE_START, RTKIT_MGMT_TYPE_END);
+  if (MessageType != RTKIT_MGMT_MSG_HELLO) {
+    DEBUG ((DEBUG_ERROR, "rtkit(%a): expected HELLO, got message type 0x%02x\n", Rtk->Name, MessageType));
+    return EFI_DEVICE_ERROR;
+  }
+
+  MinVersion = (UINT32)ANS_FIELD_GET (Msg.Msg0, RTKIT_MGMT_MSG_HELLO_MINVER_START, RTKIT_MGMT_MSG_HELLO_MINVER_END);
+  MaxVersion = (UINT32)ANS_FIELD_GET (Msg.Msg0, RTKIT_MGMT_MSG_HELLO_MAXVER_START, RTKIT_MGMT_MSG_HELLO_MAXVER_END);
+  WantVersion = MIN (RTKIT_MAX_VERSION, MaxVersion);
+
+  if ((MinVersion > RTKIT_MAX_VERSION) || (MaxVersion < RTKIT_MIN_VERSION)) {
+    DEBUG ((
+      DEBUG_ERROR,
+      "rtkit(%a): firmware speaks [%d,%d], driver speaks [%d,%d]\n",
+      Rtk->Name,
+      MinVersion,
+      MaxVersion,
+      RTKIT_MIN_VERSION,
+      RTKIT_MAX_VERSION
+      ));
+    return EFI_UNSUPPORTED;
+  }
+
+  DEBUG ((DEBUG_INFO, "rtkit(%a): booting with protocol version %d\n", Rtk->Name, WantVersion));
+
+  Msg.Msg0  = ANS_FIELD_PREP (RTKIT_MGMT_MSG_HELLO_ACK, RTKIT_MGMT_TYPE_START);
+  Msg.Msg0 |= ANS_FIELD_PREP (WantVersion, RTKIT_MGMT_MSG_HELLO_MINVER_START);
+  Msg.Msg0 |= ANS_FIELD_PREP (WantVersion, RTKIT_MGMT_MSG_HELLO_MAXVER_START);
+  Msg.Msg1  = RTKIT_EP_MGMT;
+  if (!AppleAscSend (&Rtk->Asc, &Msg)) {
+    DEBUG ((DEBUG_ERROR, "rtkit(%a): couldn't send the HELLO ack\n", Rtk->Name));
+    return EFI_DEVICE_ERROR;
+  }
+
+  HasCrashlog = FALSE;
+  HasDebug    = FALSE;
+  HasIoreport = FALSE;
+  HasSyslog   = FALSE;
+  HasOslog    = FALSE;
+  GotEpmap    = FALSE;
+
+  while (!GotEpmap) {
+    if (!AppleAscRecvTimeout (&Rtk->Asc, &Msg, 1000000)) {
+      DEBUG ((DEBUG_ERROR, "rtkit(%a): no endpoint map within 1s\n", Rtk->Name));
+      return EFI_TIMEOUT;
+    }
+
+    if (Msg.Msg1 != RTKIT_EP_MGMT) {
+      DEBUG ((DEBUG_ERROR, "rtkit(%a): expected the endpoint map, got a message for endpoint 0x%x\n", Rtk->Name, Msg.Msg1));
+      return EFI_DEVICE_ERROR;
+    }
+
+    MessageType = (UINT32)ANS_FIELD_GET (Msg.Msg0, RTKIT_MGMT_TYPE_START, RTKIT_MGMT_TYPE_END);
+    if (MessageType != RTKIT_MGMT_MSG_EPMAP) {
+      DEBUG ((DEBUG_ERROR, "rtkit(%a): expected the endpoint map, got message type 0x%x\n", Rtk->Name, MessageType));
+      return EFI_DEVICE_ERROR;
+    }
+
+    Bitmap = (UINT32)ANS_FIELD_GET (Msg.Msg0, RTKIT_MGMT_MSG_EPMAP_BITMAP_START, RTKIT_MGMT_MSG_EPMAP_BITMAP_END);
+    Base   = (UINT32)ANS_FIELD_GET (Msg.Msg0, RTKIT_MGMT_MSG_EPMAP_BASE_START, RTKIT_MGMT_MSG_EPMAP_BASE_END);
+
+    for (Index = 0; Index < 32; Index++) {
+      if ((Bitmap & (1U << Index)) == 0) {
+        continue;
+      }
+
+      EpIndex = (UINT8)(32 * Base + Index);
+      if (EpIndex >= 0x20) {
+        continue;
+      }
+
+      switch (EpIndex) {
+        case RTKIT_EP_CRASHLOG:
+          HasCrashlog = TRUE;
+          break;
+        case RTKIT_EP_DEBUG:
+          HasDebug = TRUE;
+          break;
+        case RTKIT_EP_IOREPORT:
+          HasIoreport = TRUE;
+          break;
+        case RTKIT_EP_SYSLOG:
+          HasSyslog = TRUE;
+          break;
+        case RTKIT_EP_OSLOG:
+          HasOslog = TRUE;
+          break;
+        case RTKIT_EP_MGMT:
+          break;
+        default:
+          DEBUG ((DEBUG_WARN, "rtkit(%a): unknown system endpoint 0x%02x in the map\n", Rtk->Name, EpIndex));
+          break;
+      }
+    }
+
+    GotEpmap = ((Msg.Msg0 & BIT51) != 0);
+
+    Msg.Msg0  = ANS_FIELD_PREP (RTKIT_MGMT_MSG_EPMAP_REPLY, RTKIT_MGMT_TYPE_START);
+    Msg.Msg0 |= ANS_FIELD_PREP (Base, RTKIT_MGMT_MSG_EPMAP_BASE_START);
+    if (GotEpmap) {
+      Msg.Msg0 |= BIT51;
+    } else {
+      Msg.Msg0 |= BIT0;
+    }
+
+    Msg.Msg1 = RTKIT_EP_MGMT;
+    if (!AppleAscSend (&Rtk->Asc, &Msg)) {
+      DEBUG ((DEBUG_ERROR, "rtkit(%a): couldn't reply to the endpoint map\n", Rtk->Name));
+      return EFI_DEVICE_ERROR;
+    }
+  }
+
+  //
+  // The firmware's own endpoints must be started before it will move to the
+  // ON power state, and it must be able to log while doing so.
+  //
+  if (HasDebug && !AppleRtkitStartEp (Rtk, RTKIT_EP_DEBUG)) {
+    return EFI_DEVICE_ERROR;
+  }
+
+  if (HasCrashlog && !AppleRtkitStartEp (Rtk, RTKIT_EP_CRASHLOG)) {
+    return EFI_DEVICE_ERROR;
+  }
+
+  if (HasSyslog && !AppleRtkitStartEp (Rtk, RTKIT_EP_SYSLOG)) {
+    return EFI_DEVICE_ERROR;
+  }
+
+  if (HasIoreport && !AppleRtkitStartEp (Rtk, RTKIT_EP_IOREPORT)) {
+    return EFI_DEVICE_ERROR;
+  }
+
+  if (HasOslog && !AppleRtkitStartEp (Rtk, RTKIT_EP_OSLOG)) {
+    return EFI_DEVICE_ERROR;
+  }
+
+  for (Spin = 0; Rtk->IopPower != RTKIT_POWER_ON; Spin++) {
+    if (Spin > 100000) {
+      DEBUG ((DEBUG_ERROR, "rtkit(%a): IOP never reached the ON state\n", Rtk->Name));
+      return EFI_TIMEOUT;
+    }
+
+    Ret = AppleRtkitRecv (Rtk, &RtkMsg);
+    if (Ret < 0) {
+      return EFI_DEVICE_ERROR;
+    }
+
+    if (Ret > 0) {
+      DEBUG ((DEBUG_WARN, "rtkit(%a): message for endpoint 0x%02x during boot\n", Rtk->Name, RtkMsg.Ep));
+    }
+
+    gBS->Stall (10);
+  }
+
+  //
+  // This is what enables the firmware's logging.
+  //
+  Msg.Msg0 = ANS_FIELD_PREP (RTKIT_MGMT_MSG_AP_PWR_STATE, RTKIT_MGMT_TYPE_START);
+  Msg.Msg0 |= ANS_FIELD_PREP (RTKIT_POWER_ON, RTKIT_MGMT_PWR_STATE_START);
+  Msg.Msg1 = RTKIT_EP_MGMT;
+  if (!AppleAscSend (&Rtk->Asc, &Msg)) {
+    DEBUG ((DEBUG_ERROR, "rtkit(%a): unable to send the AP power message\n", Rtk->Name));
+    return EFI_DEVICE_ERROR;
+  }
+
+  Rtk->Booted = TRUE;
+  DEBUG ((DEBUG_INFO, "rtkit(%a): firmware is up\n", Rtk->Name));
+
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+AppleRtkitSwitchPowerState (
+  IN OUT APPLE_RTKIT_DEV  *Rtk,
+  IN     UINT32           Target
+  )
+{
+  APPLE_ASC_MESSAGE    Msg;
+  APPLE_RTKIT_MESSAGE  RtkMsg;
+  INTN                 Ret;
+
+  if (Rtk->Crashed) {
+    return EFI_DEVICE_ERROR;
+  }
+
+  //
+  // AP power always goes through QUIESCED first; the firmware assumes that
+  // ordering on the way down.
+  //
+  Msg.Msg0 = ANS_FIELD_PREP (RTKIT_MGMT_MSG_AP_PWR_STATE, RTKIT_MGMT_TYPE_START);
+  Msg.Msg0 |= ANS_FIELD_PREP (RTKIT_POWER_QUIESCED, RTKIT_MGMT_PWR_STATE_START);
+  Msg.Msg1 = RTKIT_EP_MGMT;
+  if (!AppleAscSend (&Rtk->Asc, &Msg)) {
+    DEBUG ((DEBUG_ERROR, "rtkit(%a): unable to send the AP quiesce message\n", Rtk->Name));
+    return EFI_DEVICE_ERROR;
+  }
+
+  while (Rtk->ApPower != RTKIT_POWER_QUIESCED) {
+    Ret = AppleRtkitRecv (Rtk, &RtkMsg);
+    if (Ret < 0) {
+      DEBUG ((DEBUG_ERROR, "rtkit(%a): IOP died while quiescing\n", Rtk->Name));
+      return EFI_DEVICE_ERROR;
+    }
+
+    if (Ret > 0) {
+      DEBUG ((DEBUG_WARN, "rtkit(%a): message for endpoint 0x%02x while quiescing\n", Rtk->Name, RtkMsg.Ep));
+    }
+  }
+
+  Msg.Msg0 = ANS_FIELD_PREP (RTKIT_MGMT_MSG_IOP_PWR_STATE, RTKIT_MGMT_TYPE_START);
+  Msg.Msg0 |= ANS_FIELD_PREP (Target, RTKIT_MGMT_PWR_STATE_START);
+  if (!AppleAscSend (&Rtk->Asc, &Msg)) {
+    DEBUG ((DEBUG_ERROR, "rtkit(%a): unable to send the IOP power message\n", Rtk->Name));
+    return EFI_DEVICE_ERROR;
+  }
+
+  while (Rtk->IopPower != Target) {
+    Ret = AppleRtkitRecv (Rtk, &RtkMsg);
+    if (Ret < 0) {
+      DEBUG ((DEBUG_ERROR, "rtkit(%a): IOP died while changing power state\n", Rtk->Name));
+      return EFI_DEVICE_ERROR;
+    }
+
+    if (Ret > 0) {
+      DEBUG ((DEBUG_WARN, "rtkit(%a): message for endpoint 0x%02x while changing power state\n", Rtk->Name, RtkMsg.Ep));
+    }
+  }
+
+  return EFI_SUCCESS;
+}
+
+EFI_STATUS
+AppleRtkitQuiesce (
+  IN OUT APPLE_RTKIT_DEV  *Rtk
+  )
+{
+  return AppleRtkitSwitchPowerState (Rtk, RTKIT_POWER_QUIESCED);
+}
+
+EFI_STATUS
+AppleRtkitSleep (
+  IN OUT APPLE_RTKIT_DEV  *Rtk
+  )
+{
+  EFI_STATUS  Status;
+
+  Status = AppleRtkitSwitchPowerState (Rtk, RTKIT_POWER_SLEEP);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  AppleAscCpuStop (&Rtk->Asc);
+  Rtk->Booted = FALSE;
+
+  return EFI_SUCCESS;
+}
+
+VOID
+AppleRtkitFree (
+  IN OUT APPLE_RTKIT_DEV  *Rtk
+  )
+{
+  AppleRtkitFreeBuffer (Rtk, &Rtk->Syslog);
+  AppleRtkitFreeBuffer (Rtk, &Rtk->Crashlog);
+  AppleRtkitFreeBuffer (Rtk, &Rtk->Ioreport);
+}
diff --git a/Silicon/Apple/AppleSiliconPkg/Drivers/AppleNANDStorageDxe/AppleSart.c b/Silicon/Apple/AppleSiliconPkg/Drivers/AppleNANDStorageDxe/AppleSart.c
new file mode 100644
index 0000000..c5582e8
--- /dev/null
+++ b/Silicon/Apple/AppleSiliconPkg/Drivers/AppleNANDStorageDxe/AppleSart.c
@@ -0,0 +1,415 @@
+/**
+ * Copyright (c) 2023, amarioguy (AppleWOA authors). All rights reserved.
+ *
+ * Module Name:
+ *   AppleSart.c
+ *
+ * Abstract:
+ *   Apple SART (System Address Resolution Table) window table for the
+ *   coprocessor side of the ANS controller.  Ported from m1n1's src/sart.c,
+ *   including all four register layouts; the ADT's "sart-version" property
+ *   selects the layout, and a SART with neither a version nor the t8015
+ *   compatible string is refused rather than guessed at.
+ *
+ * Environment:
+ *   UEFI DXE (Driver Execution Environment).
+ *
+ * License:
+ *   SPDX-License-Identifier: BSD-2-Clause-Patent OR MIT
+ *
+ **/
+
+#include "AppleNandStorage.h"
+
+//
+// SARTv0/v2 pack flags and size into one 32-bit config word; v3/v4 moved the
+// size to its own register and left the config word as raw flags.
+//
+STATIC
+VOID
+AppleSart0GetEntry (
+  IN  APPLE_SART_DEV  *Sart,
+  IN  UINT32          Index,
+  OUT UINT8           *Flags,
+  OUT UINT64          *Paddr,
+  OUT UINT64          *Size
+  )
+{
+  UINT32  Config;
+
+  Config = MmioRead32 (Sart->Base + Sart->ConfigOffset + 4 * Index);
+  *Flags = (UINT8)ANS_FIELD_GET (Config, APPLE_SART0_CONFIG_FLAGS_START, APPLE_SART0_CONFIG_FLAGS_END);
+  *Size  = ANS_FIELD_GET (Config, APPLE_SART0_CONFIG_SIZE_START, APPLE_SART0_CONFIG_SIZE_END)
+           << APPLE_SART0_SIZE_SHIFT;
+  *Paddr = LShiftU64 (MmioRead32 (Sart->Base + Sart->PaddrOffset + 4 * Index), APPLE_SART0_PADDR_SHIFT);
+}
+
+STATIC
+BOOLEAN
+AppleSart0SetEntry (
+  IN APPLE_SART_DEV  *Sart,
+  IN UINT32          Index,
+  IN UINT8           Flags,
+  IN UINT64          Paddr,
+  IN UINT64          Size
+  )
+{
+  UINT32  Config;
+  UINT64  PaddrShifted;
+
+  if ((Size & (LShiftU64 (1, APPLE_SART0_SIZE_SHIFT) - 1)) != 0) {
+    return FALSE;
+  }
+
+  if ((Paddr & (LShiftU64 (1, APPLE_SART0_PADDR_SHIFT) - 1)) != 0) {
+    return FALSE;
+  }
+
+  Size >>= APPLE_SART0_SIZE_SHIFT;
+  if (Size > (LShiftU64 (1, APPLE_SART0_CONFIG_SIZE_END - APPLE_SART0_CONFIG_SIZE_START + 1) - 1)) {
+    return FALSE;
+  }
+
+  PaddrShifted = RShiftU64 (Paddr, APPLE_SART0_PADDR_SHIFT);
+
+  Config  = (UINT32)ANS_FIELD_PREP (
+                      Flags & ((1U << (APPLE_SART0_CONFIG_FLAGS_END - APPLE_SART0_CONFIG_FLAGS_START + 1)) - 1),
+                      APPLE_SART0_CONFIG_FLAGS_START
+                      );
+  Config |= (UINT32)ANS_FIELD_PREP (Size, APPLE_SART0_CONFIG_SIZE_START);
+
+  MmioWrite32 (Sart->Base + Sart->PaddrOffset + 4 * Index, (UINT32)PaddrShifted);
+  MmioWrite32 (Sart->Base + Sart->ConfigOffset + 4 * Index, Config);
+
+  return TRUE;
+}
+
+STATIC
+VOID
+AppleSart2GetEntry (
+  IN  APPLE_SART_DEV  *Sart,
+  IN  UINT32          Index,
+  OUT UINT8           *Flags,
+  OUT UINT64          *Paddr,
+  OUT UINT64          *Size
+  )
+{
+  UINT32  Config;
+
+  Config = MmioRead32 (Sart->Base + Sart->ConfigOffset + 4 * Index);
+  *Flags = (UINT8)ANS_FIELD_GET (Config, APPLE_SART2_CONFIG_FLAGS_START, APPLE_SART2_CONFIG_FLAGS_END);
+  *Size  = ANS_FIELD_GET (Config, APPLE_SART2_CONFIG_SIZE_START, APPLE_SART2_CONFIG_SIZE_END)
+           << APPLE_SART2_SIZE_SHIFT;
+  *Paddr = LShiftU64 (MmioRead32 (Sart->Base + Sart->PaddrOffset + 4 * Index), APPLE_SART2_PADDR_SHIFT);
+}
+
+STATIC
+BOOLEAN
+AppleSart2SetEntry (
+  IN APPLE_SART_DEV  *Sart,
+  IN UINT32          Index,
+  IN UINT8           Flags,
+  IN UINT64          Paddr,
+  IN UINT64          Size
+  )
+{
+  UINT32  Config;
+  UINT64  PaddrShifted;
+
+  if ((Size & (LShiftU64 (1, APPLE_SART2_SIZE_SHIFT) - 1)) != 0) {
+    return FALSE;
+  }
+
+  if ((Paddr & (LShiftU64 (1, APPLE_SART2_PADDR_SHIFT) - 1)) != 0) {
+    return FALSE;
+  }
+
+  Size >>= APPLE_SART2_SIZE_SHIFT;
+  if (Size > (LShiftU64 (1, APPLE_SART2_CONFIG_SIZE_END - APPLE_SART2_CONFIG_SIZE_START + 1) - 1)) {
+    return FALSE;
+  }
+
+  PaddrShifted = RShiftU64 (Paddr, APPLE_SART2_PADDR_SHIFT);
+
+  Config  = (UINT32)ANS_FIELD_PREP (Flags, APPLE_SART2_CONFIG_FLAGS_START);
+  Config |= (UINT32)ANS_FIELD_PREP (Size, APPLE_SART2_CONFIG_SIZE_START);
+
+  MmioWrite32 (Sart->Base + Sart->PaddrOffset + 4 * Index, (UINT32)PaddrShifted);
+  MmioWrite32 (Sart->Base + Sart->ConfigOffset + 4 * Index, Config);
+
+  return TRUE;
+}
+
+STATIC
+VOID
+AppleSart3GetEntry (
+  IN  APPLE_SART_DEV  *Sart,
+  IN  UINT32          Index,
+  OUT UINT8           *Flags,
+  OUT UINT64          *Paddr,
+  OUT UINT64          *Size
+  )
+{
+  *Flags = (UINT8)MmioRead32 (Sart->Base + Sart->ConfigOffset + 4 * Index);
+  *Size  = LShiftU64 (MmioRead32 (Sart->Base + Sart->SizeOffset + 4 * Index), APPLE_SART3_SIZE_SHIFT);
+  *Paddr = LShiftU64 (MmioRead32 (Sart->Base + Sart->PaddrOffset + 4 * Index), APPLE_SART3_PADDR_SHIFT);
+}
+
+STATIC
+BOOLEAN
+AppleSart3SetEntry (
+  IN APPLE_SART_DEV  *Sart,
+  IN UINT32          Index,
+  IN UINT8           Flags,
+  IN UINT64          Paddr,
+  IN UINT64          Size
+  )
+{
+  if ((Size & (LShiftU64 (1, APPLE_SART3_SIZE_SHIFT) - 1)) != 0) {
+    return FALSE;
+  }
+
+  if ((Paddr & (LShiftU64 (1, APPLE_SART3_PADDR_SHIFT) - 1)) != 0) {
+    return FALSE;
+  }
+
+  Size >>= APPLE_SART3_SIZE_SHIFT;
+  if (Size > (LShiftU64 (1, APPLE_SART3_SIZE_END - APPLE_SART3_SIZE_START + 1) - 1)) {
+    return FALSE;
+  }
+
+  MmioWrite32 (Sart->Base + Sart->PaddrOffset + 4 * Index, (UINT32)RShiftU64 (Paddr, APPLE_SART3_PADDR_SHIFT));
+  MmioWrite32 (Sart->Base + Sart->SizeOffset + 4 * Index, (UINT32)Size);
+  MmioWrite32 (Sart->Base + Sart->ConfigOffset + 4 * Index, Flags);
+
+  return TRUE;
+}
+
+STATIC
+VOID
+AppleSart4GetEntry (
+  IN  APPLE_SART_DEV  *Sart,
+  IN  UINT32          Index,
+  OUT UINT8           *Flags,
+  OUT UINT64          *Paddr,
+  OUT UINT64          *Size
+  )
+{
+  *Flags = (UINT8)MmioRead32 (Sart->Base + Sart->ConfigOffset + 4 * Index);
+  *Size  = LShiftU64 (MmioRead32 (Sart->Base + Sart->SizeOffset + 4 * Index), APPLE_SART4_SIZE_SHIFT);
+  *Paddr = LShiftU64 (MmioRead32 (Sart->Base + Sart->PaddrOffset + 4 * Index), APPLE_SART4_PADDR_SHIFT);
+}
+
+STATIC
+BOOLEAN
+AppleSart4SetEntry (
+  IN APPLE_SART_DEV  *Sart,
+  IN UINT32          Index,
+  IN UINT8           Flags,
+  IN UINT64          Paddr,
+  IN UINT64          Size
+  )
+{
+  if ((Size & (LShiftU64 (1, APPLE_SART4_SIZE_SHIFT) - 1)) != 0) {
+    return FALSE;
+  }
+
+  if ((Paddr & (LShiftU64 (1, APPLE_SART4_PADDR_SHIFT) - 1)) != 0) {
+    return FALSE;
+  }
+
+  Size >>= APPLE_SART4_SIZE_SHIFT;
+  if (Size > (LShiftU64 (1, APPLE_SART4_SIZE_END - APPLE_SART4_SIZE_START + 1) - 1)) {
+    return FALSE;
+  }
+
+  MmioWrite32 (Sart->Base + Sart->PaddrOffset + 4 * Index, (UINT32)RShiftU64 (Paddr, APPLE_SART4_PADDR_SHIFT));
+  MmioWrite32 (Sart->Base + Sart->SizeOffset + 4 * Index, (UINT32)Size);
+  MmioWrite32 (Sart->Base + Sart->ConfigOffset + 4 * Index, Flags);
+
+  return TRUE;
+}
+
+EFI_STATUS
+AppleSartInit (
+  IN  dt_node_t       *SartNode,
+  OUT APPLE_SART_DEV  *Sart
+  )
+{
+  uint64_t  Base;
+  UINT32    Version;
+  UINT32    *VersionProp;
+  UINT32  Index;
+  UINT32  Protected;
+  UINT8   Flags;
+  UINT64  Paddr;
+  UINT64  Size;
+
+  if (SartNode == NULL) {
+    return EFI_NOT_FOUND;
+  }
+
+  Base = 0;
+  if (dt_node_reg (SartNode, 0, &Base, NULL) != 0 || Base == 0) {
+    DEBUG ((DEBUG_ERROR, "sart: no usable reg[0] on the SART node\n"));
+    return EFI_NOT_FOUND;
+  }
+
+  VersionProp = (UINT32 *)dt_node_prop (SartNode, "sart-version", NULL);
+  if (VersionProp != NULL) {
+    Version = *VersionProp;
+  } else if (dt_node_prop (SartNode, "compatible", NULL) != NULL) {
+    //
+    // t8015 predates sart-version and is SARTv0 by definition.  Anything else
+    // without the property is unknown; guessing a register layout for a DMA
+    // window table is not something a wrong guess recovers from.
+    //
+    CHAR8   *Compat;
+    size_t  CompatLen;
+
+    Compat = (CHAR8 *)dt_node_prop (SartNode, "compatible", &CompatLen);
+    if ((Compat != NULL) && (AsciiStrStr (Compat, "sart,t8015") != NULL)) {
+      Version = 0;
+    } else {
+      DEBUG ((DEBUG_ERROR, "sart: node has no sart-version property\n"));
+      return EFI_UNSUPPORTED;
+    }
+  } else {
+    DEBUG ((DEBUG_ERROR, "sart: node has neither sart-version nor compatible\n"));
+    return EFI_UNSUPPORTED;
+  }
+
+  ZeroMem (Sart, sizeof (*Sart));
+  Sart->Base    = (UINTN)Base;
+  Sart->Version = Version;
+
+  switch (Version) {
+    case 0:
+      Sart->GetEntry = AppleSart0GetEntry;
+      Sart->SetEntry = AppleSart0SetEntry;
+      Sart->FlagsAllow = APPLE_SART0_FLAGS_ALLOW;
+      Sart->ConfigOffset = APPLE_SART0_CONFIG_OFFSET;
+      Sart->PaddrOffset  = APPLE_SART0_PADDR_OFFSET;
+      break;
+    case 2:
+      Sart->GetEntry = AppleSart2GetEntry;
+      Sart->SetEntry = AppleSart2SetEntry;
+      Sart->FlagsAllow = APPLE_SART2_FLAGS_ALLOW;
+      Sart->ConfigOffset = APPLE_SART2_CONFIG_OFFSET;
+      Sart->PaddrOffset  = APPLE_SART2_PADDR_OFFSET;
+      break;
+    case 3:
+      Sart->GetEntry = AppleSart3GetEntry;
+      Sart->SetEntry = AppleSart3SetEntry;
+      Sart->FlagsAllow = APPLE_SART3_FLAGS_ALLOW;
+      Sart->ConfigOffset = APPLE_SART3_CONFIG_OFFSET;
+      Sart->PaddrOffset  = APPLE_SART3_PADDR_OFFSET;
+      Sart->SizeOffset   = APPLE_SART3_SIZE_OFFSET;
+      break;
+    case 4:
+      Sart->GetEntry = AppleSart4GetEntry;
+      Sart->SetEntry = AppleSart4SetEntry;
+      Sart->FlagsAllow = APPLE_SART4_FLAGS_ALLOW;
+      Sart->ConfigOffset = APPLE_SART4_CONFIG_OFFSET;
+      Sart->PaddrOffset  = APPLE_SART4_PADDR_OFFSET;
+      Sart->SizeOffset   = APPLE_SART4_SIZE_OFFSET;
+      break;
+    default:
+      DEBUG ((DEBUG_ERROR, "sart: unknown sart-version %d\n", Version));
+      return EFI_UNSUPPORTED;
+  }
+
+ //
+  // Entries the boot chain already owns are never touched: they cover the
+  // coprocessor's own firmware and the region iBoot handed it.
+  //
+  Sart->ProtectedEntries = 0;
+  for (Index = 0; Index < APPLE_SART_MAX_ENTRIES; Index++) {
+    Sart->GetEntry (Sart, Index, &Flags, &Paddr, &Size);
+    if (Flags != 0) {
+      Sart->ProtectedEntries |= (1U << Index);
+    }
+
+    DEBUG ((
+      DEBUG_INFO,
+      "sart: entry %2d flags 0x%02x paddr 0x%lx size 0x%lx%s\n",
+      Index,
+      Flags,
+      Paddr,
+      Size,
+      ((Sart->ProtectedEntries & (1U << Index)) != 0) ? " (protected)" : ""
+      ));
+  }
+
+  for (Index = 0, Protected = 0; Index < APPLE_SART_MAX_ENTRIES; Index++) {
+    if ((Sart->ProtectedEntries & (1U << Index)) != 0) {
+      Protected++;
+    }
+  }
+
+  DEBUG ((DEBUG_INFO, "sart: SARTv%d at 0x%lx, %d protected entries\n", Version, Base, Protected));
+
+  return EFI_SUCCESS;
+}
+
+BOOLEAN
+AppleSartAddAllowedRegion (
+  IN APPLE_SART_DEV  *Sart,
+  IN UINT64          Paddr,
+  IN UINT64          Size
+  )
+{
+  UINT32  Index;
+  UINT8   EntryFlags;
+  UINT64  EntryPaddr;
+  UINT64  EntrySize;
+
+  for (Index = 0; Index < APPLE_SART_MAX_ENTRIES; Index++) {
+    if ((Sart->ProtectedEntries & (1U << Index)) != 0) {
+      continue;
+    }
+
+    Sart->GetEntry (Sart, Index, &EntryFlags, &EntryPaddr, &EntrySize);
+    if (EntryFlags != 0) {
+      continue;
+    }
+
+    return Sart->SetEntry (Sart, Index, (UINT8)Sart->FlagsAllow, Paddr, Size);
+  }
+
+  DEBUG ((DEBUG_ERROR, "sart: no free entries for 0x%lx+0x%lx\n", Paddr, Size));
+  return FALSE;
+}
+
+BOOLEAN
+AppleSartRemoveAllowedRegion (
+  IN APPLE_SART_DEV  *Sart,
+  IN UINT64          Paddr,
+  IN UINT64          Size
+  )
+{
+  UINT32  Index;
+  UINT8   EntryFlags;
+  UINT64  EntryPaddr;
+  UINT64  EntrySize;
+
+  for (Index = 0; Index < APPLE_SART_MAX_ENTRIES; Index++) {
+    if ((Sart->ProtectedEntries & (1U << Index)) != 0) {
+      continue;
+    }
+
+    Sart->GetEntry (Sart, Index, &EntryFlags, &EntryPaddr, &EntrySize);
+    if (EntryFlags == 0) {
+      continue;
+    }
+
+    if ((EntryPaddr != Paddr) || (EntrySize != Size)) {
+      continue;
+    }
+
+    return Sart->SetEntry (Sart, Index, 0, 0, 0);
+  }
+
+  DEBUG ((DEBUG_WARN, "sart: no entry matches 0x%lx+0x%lx\n", Paddr, Size));
+  return FALSE;
+}
