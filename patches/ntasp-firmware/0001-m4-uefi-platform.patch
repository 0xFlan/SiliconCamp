diff --git a/Silicon/Apple/AppleSiliconPkg/Drivers/AppleNANDStorageDxe/AppleAsc.c b/Silicon/Apple/AppleSiliconPkg/Drivers/AppleNANDStorageDxe/AppleAsc.c
new file mode 100644
index 0000000..24647ea
--- /dev/null
+++ b/Silicon/Apple/AppleSiliconPkg/Drivers/AppleNANDStorageDxe/AppleAsc.c
@@ -0,0 +1,234 @@
+/**
+ * Copyright (c) 2023, amarioguy (AppleWOA authors). All rights reserved.
+ *
+ * Module Name:
+ *   AppleAsc.c
+ *
+ * Abstract:
+ *   Apple Storage Coprocessor (ASC) mailbox access for the ANS/ANS2 storage
+ *   controller.  Ported from m1n1's src/asc.c.
+ *
+ * Environment:
+ *   UEFI DXE (Driver Execution Environment).
+ *
+ * License:
+ *   SPDX-License-Identifier: BSD-2-Clause-Patent OR MIT
+ *
+ **/
+
+#include "AppleNandStorage.h"
+
+typedef struct {
+  dt_node_t    *First;
+  UINT32       WantDepth;
+} ANS_FIRST_CHILD_ARG;
+
+//
+// dt_parse's callback takes a plain `int`, which is EDK2's INT32.
+//
+STATIC
+INT32
+AppleDtFirstChildCb (
+  IN VOID       *Arg,
+  IN dt_node_t  *Node,
+  IN INT32      Depth
+  )
+{
+  ANS_FIRST_CHILD_ARG *Search = (ANS_FIRST_CHILD_ARG *)Arg;
+
+  if ((Depth == (INT32)Search->WantDepth) && (Search->First == NULL)) {
+    Search->First = Node;
+  }
+
+  //
+  // Stop once the first child has been recorded: everything deeper is
+  // irrelevant and the ADT can be large.
+  //
+  return (Search->First != NULL) ? 1 : 0;
+}
+
+//
+// m1n1 walks the raw ADT and takes the first child of the ANS node as the IOP
+// node (`asc-dram-mask` lives there).  There is no name to match on, so this
+// does the same by depth.
+//
+STATIC
+dt_node_t *
+AppleDtFirstChild (
+  IN dt_node_t  *Node
+  )
+{
+  ANS_FIRST_CHILD_ARG Search;
+
+  Search.First     = NULL;
+  Search.WantDepth = 1;
+  dt_parse (Node, 0, NULL, AppleDtFirstChildCb, &Search, NULL, NULL);
+  return Search.First;
+}
+
+EFI_STATUS
+AppleAscInit (
+  IN  dt_node_t      *AnsNode,
+  OUT APPLE_ASC_DEV  *Asc
+  )
+{
+  uint64_t  Base;
+
+  if (AnsNode == NULL) {
+    return EFI_NOT_FOUND;
+  }
+
+  //
+  // AppleDTLib speaks stdint types, EDK2 code speaks its own; the two are the
+  // same width on AArch64 but not the same type name, so convert explicitly.
+  //
+  Base = 0;
+  if (dt_node_reg (AnsNode, 0, &Base, NULL) != 0 || Base == 0) {
+    DEBUG ((DEBUG_ERROR, "asc: /arm-io/ans has no usable reg[0]\n"));
+    return EFI_NOT_FOUND;
+  }
+
+  ZeroMem (Asc, sizeof (*Asc));
+  Asc->AnsNode = AnsNode;
+  Asc->CpuBase = (UINTN)Base;
+  Asc->Base    = (UINTN)Base + ASC_MAILBOX_OFFSET;
+  Asc->IopNode = AppleDtFirstChild (AnsNode);
+
+  if (Asc->IopNode == NULL) {
+    DEBUG ((DEBUG_WARN, "asc: no IOP child node under /arm-io/ans; asc-dram-mask will be 0\n"));
+  }
+
+  DEBUG ((
+    DEBUG_INFO,
+    "asc: reg[0] 0x%lx, mailboxes at 0x%lx, iop node %a\n",
+    Base,
+    (UINT64)Asc->Base,
+    (Asc->IopNode != NULL) ? "found" : "missing"
+    ));
+
+  return EFI_SUCCESS;
+}
+
+VOID
+AppleAscCpuStart (
+  IN APPLE_ASC_DEV  *Asc
+  )
+{
+  MmioOr32 (Asc->CpuBase + ASC_CPU_CONTROL, ASC_CPU_CONTROL_START);
+}
+
+VOID
+AppleAscCpuStop (
+  IN APPLE_ASC_DEV  *Asc
+  )
+{
+  MmioAnd32 (Asc->CpuBase + ASC_CPU_CONTROL, (UINT32)~ASC_CPU_CONTROL_START);
+}
+
+BOOLEAN
+AppleAscCpuRunning (
+  IN APPLE_ASC_DEV  *Asc
+  )
+{
+  return (MmioRead32 (Asc->CpuBase + ASC_CPU_CONTROL) & ASC_CPU_CONTROL_START) != 0;
+}
+
+BOOLEAN
+AppleAscCanSend (
+  IN APPLE_ASC_DEV  *Asc
+  )
+{
+  return (MmioRead32 (Asc->Base + ASC_MBOX_A2I_CONTROL) & ASC_MBOX_CONTROL_FULL) == 0;
+}
+
+BOOLEAN
+AppleAscCanRecv (
+  IN APPLE_ASC_DEV  *Asc
+  )
+{
+  return (MmioRead32 (Asc->Base + ASC_MBOX_I2A_CONTROL) & ASC_MBOX_CONTROL_EMPTY) == 0;
+}
+
+BOOLEAN
+AppleAscSend (
+  IN APPLE_ASC_DEV           *Asc,
+  IN CONST APPLE_ASC_MESSAGE *Msg
+  )
+{
+  UINT32  Timeout;
+
+  //
+  // m1n1 waits up to 200 ms for the IOP to drain its receive FIFO.  A FIFO
+  // that stays full means the coprocessor is stuck, and reporting that is
+  // better than writing into a full mailbox.
+  //
+  for (Timeout = 0; Timeout < 2000; Timeout++) {
+    if (AppleAscCanSend (Asc)) {
+      break;
+    }
+
+    gBS->Stall (100);
+  }
+
+  if (!AppleAscCanSend (Asc)) {
+    DEBUG ((DEBUG_ERROR, "asc: A2I mailbox full for 200ms; is the ASC stuck?\n"));
+    return FALSE;
+  }
+
+  MemoryFence ();
+  MmioWrite64 (Asc->Base + ASC_MBOX_A2I_SEND0, Msg->Msg0);
+  MmioWrite64 (Asc->Base + ASC_MBOX_A2I_SEND1, Msg->Msg1);
+
+  return TRUE;
+}
+
+BOOLEAN
+AppleAscRecv (
+  IN  APPLE_ASC_DEV     *Asc,
+  OUT APPLE_ASC_MESSAGE *Msg
+  )
+{
+  if (!AppleAscCanRecv (Asc)) {
+    return FALSE;
+  }
+
+  Msg->Msg0 = MmioRead64 (Asc->Base + ASC_MBOX_I2A_RECV0);
+  Msg->Msg1 = (UINT32)MmioRead64 (Asc->Base + ASC_MBOX_I2A_RECV1);
+  MemoryFence ();
+
+  return TRUE;
+}
+
+BOOLEAN
+AppleAscRecvTimeout (
+  IN  APPLE_ASC_DEV     *Asc,
+  OUT APPLE_ASC_MESSAGE *Msg,
+  IN  UINT32            DelayUsec
+  )
+{
+  UINT32  Elapsed;
+
+  for (Elapsed = 0; Elapsed < DelayUsec; Elapsed++) {
+    if (AppleAscRecv (Asc, Msg)) {
+      return TRUE;
+    }
+
+    gBS->Stall (1);
+  }
+
+  return FALSE;
+}
+
+VOID
+AppleAscDrain (
+  IN APPLE_ASC_DEV  *Asc
+  )
+{
+  APPLE_ASC_MESSAGE  Msg;
+
+  for (;;) {
+    if (!AppleAscRecv (Asc, &Msg)) {
+      break;
+    }
+  }
+}
diff --git a/Silicon/Apple/AppleSiliconPkg/Drivers/AppleNANDStorageDxe/AppleNANDStorageDxe.c b/Silicon/Apple/AppleSiliconPkg/Drivers/AppleNANDStorageDxe/AppleNANDStorageDxe.c
index dff86f1..3982915 100644
--- a/Silicon/Apple/AppleSiliconPkg/Drivers/AppleNANDStorageDxe/AppleNANDStorageDxe.c
+++ b/Silicon/Apple/AppleSiliconPkg/Drivers/AppleNANDStorageDxe/AppleNANDStorageDxe.c
@@ -1,23 +1,1191 @@
 /**
- * Copyright (c) 2023, amarioguy (AppleWOA authors).
- * 
+ * Copyright (c) 2023, amarioguy (AppleWOA authors). All rights reserved.
+ *
  * Module Name:
- *     AppleNANDStorageDxe.c
- * 
+ *   AppleNandStorageDxe.c
+ *
  * Abstract:
- *     Apple NAND Storage controller driver for Apple Silicon platforms.
- * 
+ *   Apple ANS/ANS2 storage controller driver.  Apple's internal SSD is an NVMe
+ *   engine behind a coprocessor, not a PCIe NVMe device: the controller has to
+ *   be woken through an ASC mailbox and an RTKit handshake, its DMA path goes
+ *   through Apple's NVMMU (one TCB descriptor per submission slot) and its
+ *   address translation for the coprocessor side is a SART window table.
+ *
+ *   The register-level sequence is a port of m1n1's src/nvme.c, which is the
+ *   only public implementation of this controller; the register offsets are
+ *   cross-checked against m1n1 by scripts/check-ans2-constants.py so the two
+ *   cannot drift apart silently.
+ *
+ *   Deliberately not done here:
+ *   - the controller is left enabled at ExitBootServices.  An OS driver that
+ *     understands the ANS can adopt a running controller; a driver that starts
+ *     with a stopped one has to reproduce the RTKit handshake itself, and no
+ *     Windows ANS driver exists yet.
+ *   - multi-block transfers use one command per block.  Apple's NVMe engine
+ *     wants PRP lists for anything larger, and a single-page command is the
+ *     path m1n1 exercises on hardware.  The bounce buffer keeps every DMA
+ *     address known and page-aligned.
+ *
  * Environment:
- *     UEFI DXE (Driver Execution Environment).
- * 
+ *   UEFI DXE (Driver Execution Environment).
+ *
  * License:
- *     SPDX-License-Identifier: BSD-2-Clause-Patent OR MIT
- * 
-*/
+ *   SPDX-License-Identifier: BSD-2-Clause-Patent OR MIT
+ *
+ **/
+
+#include "AppleNandStorage.h"
+
+#define ANS_ALIGN_16K  0x4000
+
+//
+// Identify Controller fields this driver reports (NVMe 1.4 figure 248).
+//
+#define NVME_ID_CTRL_SERIAL_OFFSET   4
+#define NVME_ID_CTRL_SERIAL_LENGTH   20
+#define NVME_ID_CTRL_MODEL_OFFSET    24
+#define NVME_ID_CTRL_MODEL_LENGTH    40
+#define NVME_ID_CTRL_FIRMWARE_OFFSET 64
+#define NVME_ID_CTRL_FIRMWARE_LENGTH 8
+
+typedef struct {
+  BOOLEAN               Initialized;
+  UINT32                Type;
+  UINT64                NvmeBase;
+  UINT64                NvmmuBase;
+  UINT32                Die;
+  UINT32                Nsid;
+
+  APPLE_ASC_DEV         Asc;
+  APPLE_SART_DEV        Sart;
+  APPLE_RTKIT_DEV       Rtkit;
+  BOOLEAN               RtkitUp;
+
+  APPLE_NVME_QUEUE      AdminQueue;
+  APPLE_NVME_QUEUE      IoQueue;
+
+  UINT8                 *BounceBuffer;
+  UINT8                 *IdentifyBuffer;
+
+  UINT32                BlockSize;
+  UINT64                LastBlock;
+
+  EFI_BLOCK_IO_MEDIA    Media;
+  EFI_BLOCK_IO_PROTOCOL BlockIo;
+  EFI_HANDLE            Handle;
+} ANS_DEVICE;
+
+STATIC ANS_DEVICE  mAns;
+
+//
+// --------------------------------------------------------------------------
+// Register access.  The NVMe engine and the NVMMU are separate regions on M4
+// (T8132) and the same region on M1-M3 (T8103).
+// --------------------------------------------------------------------------
+//
+
+STATIC
+UINT32
+AnsNvmeRead32 (
+  IN UINT64  Offset
+  )
+{
+  return MmioRead32 ((UINTN)(mAns.NvmeBase + Offset));
+}
+
+STATIC
+VOID
+AnsNvmeWrite32 (
+  IN UINT64  Offset,
+  IN UINT32  Value
+  )
+{
+  MmioWrite32 ((UINTN)(mAns.NvmeBase + Offset), Value);
+}
+
+STATIC
+UINT32
+AnsNvmmuRead32 (
+  IN UINT64  Offset
+  )
+{
+  return MmioRead32 ((UINTN)(mAns.NvmmuBase + Offset));
+}
+
+STATIC
+VOID
+AnsNvmmuWrite32 (
+  IN UINT64  Offset,
+  IN UINT32  Value
+  )
+{
+  MmioWrite32 ((UINTN)(mAns.NvmmuBase + Offset), Value);
+}
+
+STATIC
+VOID
+AnsNvmeWrite64 (
+  IN UINT64  Offset,
+  IN UINT64  Value
+  )
+{
+  MmioWrite64 ((UINTN)(mAns.NvmeBase + Offset), Value);
+}
+
+STATIC
+VOID
+AnsNvmmuWrite64 (
+  IN UINT64  Offset,
+  IN UINT64  Value
+  )
+{
+  MmioWrite64 ((UINTN)(mAns.NvmmuBase + Offset), Value);
+}
+
+//
+// --------------------------------------------------------------------------
+// Firmware mailbox plumbing.
+// --------------------------------------------------------------------------
+//
+
+//
+// The firmware logs to its syslog ring continuously and blocks if the driver
+// stops draining it, so every wait in this file goes through here.
+//
+STATIC
+BOOLEAN
+AnsPollFirmware (
+  VOID
+  )
+{
+  APPLE_RTKIT_MESSAGE  Msg;
+  INTN                 Ret;
+
+  if (!mAns.RtkitUp) {
+    return TRUE;
+  }
+
+  for (;;) {
+    Ret = AppleRtkitRecv (&mAns.Rtkit, &Msg);
+    if (Ret < 0) {
+      DEBUG ((DEBUG_ERROR, "ans: the firmware reported a crash\n"));
+      return FALSE;
+    }
+
+    if (Ret == 0) {
+      return TRUE;
+    }
+
+    DEBUG ((DEBUG_WARN, "ans: message for endpoint 0x%02x: 0x%lx\n", Msg.Ep, Msg.Msg));
+  }
+}
+
+STATIC
+BOOLEAN
+AnsWaitRegister (
+  IN UINT64   Offset,
+  IN UINT32   Mask,
+  IN UINT32   Value,
+  IN UINT32   TimeoutUsec
+  )
+{
+  UINT32  Elapsed;
+
+  for (Elapsed = 0; Elapsed < TimeoutUsec; Elapsed += 10) {
+    if ((AnsNvmeRead32 (Offset) & Mask) == Value) {
+      return TRUE;
+    }
+
+    AnsPollFirmware ();
+    gBS->Stall (10);
+  }
+
+  return (AnsNvmeRead32 (Offset) & Mask) == Value;
+}
+
+STATIC
+BOOLEAN
+AnsWaitRegisterBits (
+  IN UINT64  Offset,
+  IN UINT32  Mask,
+  IN UINT32  TimeoutUsec
+  )
+{
+  UINT32  Elapsed;
+
+  for (Elapsed = 0; Elapsed < TimeoutUsec; Elapsed += 10) {
+    if ((AnsNvmeRead32 (Offset) & Mask) != 0) {
+      return TRUE;
+    }
+
+    AnsPollFirmware ();
+    gBS->Stall (10);
+  }
+
+  return (AnsNvmeRead32 (Offset) & Mask) != 0;
+}
+
+//
+// --------------------------------------------------------------------------
+// Queues.
+// --------------------------------------------------------------------------
+//
+
+STATIC
+VOID
+AnsFreeQueue (
+  IN OUT APPLE_NVME_QUEUE  *Queue
+  )
+{
+  if (Queue->Tcbs != NULL) {
+    FreeAlignedPages (Queue->Tcbs, EFI_SIZE_TO_PAGES (NVME_QUEUE_SIZE * sizeof (APPLE_NVMMU_TCB)));
+  }
+
+  if (Queue->Cmds != NULL) {
+    FreeAlignedPages (Queue->Cmds, EFI_SIZE_TO_PAGES (NVME_QUEUE_SIZE * sizeof (APPLE_NVME_COMMAND)));
+  }
+
+  if (Queue->Cqes != NULL) {
+    FreeAlignedPages (Queue->Cqes, EFI_SIZE_TO_PAGES (NVME_QUEUE_SIZE * sizeof (APPLE_NVME_COMPLETION)));
+  }
+
+  ZeroMem (Queue, sizeof (*Queue));
+}
+
+STATIC
+EFI_STATUS
+AnsAllocateQueue (
+  IN OUT APPLE_NVME_QUEUE  *Queue,
+  IN     BOOLEAN           AdminQueue
+  )
+{
+  ZeroMem (Queue, sizeof (*Queue));
+
+  Queue->Tcbs = AllocateAlignedPages (
+                  EFI_SIZE_TO_PAGES (NVME_QUEUE_SIZE * sizeof (APPLE_NVMMU_TCB)),
+                  ANS_ALIGN_16K
+                  );
+  if (Queue->Tcbs == NULL) {
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  Queue->Cmds = AllocateAlignedPages (
+                  EFI_SIZE_TO_PAGES (NVME_QUEUE_SIZE * sizeof (APPLE_NVME_COMMAND)),
+                  ANS_ALIGN_16K
+                  );
+  if (Queue->Cmds == NULL) {
+    AnsFreeQueue (Queue);
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  Queue->Cqes = AllocateAlignedPages (
+                  EFI_SIZE_TO_PAGES (NVME_QUEUE_SIZE * sizeof (APPLE_NVME_COMPLETION)),
+                  ANS_ALIGN_16K
+                  );
+  if (Queue->Cqes == NULL) {
+    AnsFreeQueue (Queue);
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  ZeroMem (Queue->Tcbs, NVME_QUEUE_SIZE * sizeof (APPLE_NVMMU_TCB));
+  ZeroMem (Queue->Cmds, NVME_QUEUE_SIZE * sizeof (APPLE_NVME_COMMAND));
+  ZeroMem (Queue->Cqes, NVME_QUEUE_SIZE * sizeof (APPLE_NVME_COMPLETION));
+
+  Queue->CqHead   = 0;
+  Queue->CqPhase  = 1;
+  Queue->AdminQueue = AdminQueue;
+
+  return EFI_SUCCESS;
+}
+
+//
+// Submit one command in slot 0 of a queue and wait for its completion.  Apple's
+// engine takes the DMA description from the NVMMU TCB for the same slot, so
+// both have to be written before the doorbell.
+//
+STATIC
+EFI_STATUS
+AnsExecuteCommand (
+  IN  APPLE_NVME_QUEUE  *Queue,
+  IN  APPLE_NVME_COMMAND *Command,
+  OUT UINT64            *Result OPTIONAL
+  )
+{
+  APPLE_NVME_COMMAND     *QueueCommand;
+  APPLE_NVMMU_TCB        *Tcb;
+  APPLE_NVME_COMPLETION  Completion;
+  UINT32                 Elapsed;
+  BOOLEAN                Found;
+  CONST UINT8            Tag = 0;
+
+  QueueCommand = &Queue->Cmds[Tag];
+  Tcb          = &Queue->Tcbs[Tag];
+
+  CopyMem (QueueCommand, Command, sizeof (*Command));
+  QueueCommand->Tag = Tag;
+
+  ZeroMem (Tcb, sizeof (*Tcb));
+  if (QueueCommand->Prp1 == 0) {
+    Tcb->DmaFlags = 0;
+  } else if ((QueueCommand->Opcode & 1) != 0) {
+    Tcb->DmaFlags = NVMMU_TCB_DMA_TO_DEVICE;
+  } else {
+    Tcb->DmaFlags = NVMMU_TCB_DMA_FROM_DEVICE;
+  }
+
+  Tcb->SlotId = Tag;
+  Tcb->Len    = QueueCommand->Cdw12;
+  Tcb->Prp1   = QueueCommand->Prp1;
+  Tcb->Prp2   = QueueCommand->Prp2;
+
+  MemoryFence ();
+
+  //
+  // The firmware has to see the command and its TCB before the doorbell.
+  //
+  if (!AnsPollFirmware ()) {
+    return EFI_DEVICE_ERROR;
+  }
+
+  if (Queue->AdminQueue) {
+    AnsNvmeWrite32 (NVME_DB_LINEAR_ASQ, Tag);
+  } else {
+    AnsNvmeWrite32 (NVME_DB_LINEAR_IOSQ, Tag);
+  }
+
+  Found = FALSE;
+  for (Elapsed = 0; Elapsed < NVME_TIMEOUT_USEC; Elapsed += 10) {
+    if (!AnsPollFirmware ()) {
+      return EFI_DEVICE_ERROR;
+    }
+
+    MemoryFence ();
+    CopyMem (&Completion, &Queue->Cqes[Queue->CqHead], sizeof (Completion));
+
+    if ((Completion.Status & 1) != Queue->CqPhase) {
+      gBS->Stall (10);
+      continue;
+    }
+
+    if (Completion.Tag != Tag) {
+      DEBUG ((DEBUG_WARN, "ans: completion for tag %d, expected %d\n", Completion.Tag, Tag));
+    } else {
+      Found = TRUE;
+      if (Result != NULL) {
+        *Result = Completion.Result;
+      }
+    }
+
+    AnsNvmmuWrite32 (NVMMU_TCB_INVAL, Completion.Tag);
+    if (AnsNvmmuRead32 (NVMMU_TCB_STAT) != 0) {
+      DEBUG ((DEBUG_WARN, "ans: NVMMU invalidation of tag %d failed\n", Completion.Tag));
+    }
+
+    Queue->CqHead++;
+    if (Queue->CqHead == NVME_QUEUE_SIZE) {
+      Queue->CqHead = 0;
+      Queue->CqPhase ^= 1;
+    }
+
+    if (Queue->AdminQueue) {
+      AnsNvmeWrite32 (NVME_DB_ACQ, Queue->CqHead);
+    } else {
+      AnsNvmeWrite32 (NVME_DB_IOCQ, Queue->CqHead);
+    }
+
+    break;
+  }
+
+  if (!Found) {
+    DEBUG ((DEBUG_ERROR, "ans: no completion for command 0x%02x\n", Command->Opcode));
+    return EFI_TIMEOUT;
+  }
+
+  Completion.Status >>= 1;
+  if (Completion.Status != 0) {
+    DEBUG ((DEBUG_ERROR, "ans: command 0x%02x failed with status 0x%x\n", Command->Opcode, Completion.Status));
+    return EFI_DEVICE_ERROR;
+  }
+
+  return EFI_SUCCESS;
+}
+
+STATIC
+BOOLEAN
+AnsControllerDisable (
+  VOID
+  )
+{
+  AnsNvmeWrite32 (NVME_CC, AnsNvmeRead32 (NVME_CC) & ~NVME_CC_EN_BIT);
+  return AnsWaitRegister (NVME_CSTS, NVME_CSTS_RDY_BIT, 0, NVME_TIMEOUT_USEC);
+}
+
+STATIC
+BOOLEAN
+AnsControllerEnable (
+  VOID
+  )
+{
+  UINT32  Cc;
+
+  Cc  = AnsNvmeRead32 (NVME_CC);
+  Cc &= ~(UINT32)((BIT15 | BIT14));      // clear the shutdown notification bits
+  Cc |= NVME_CC_EN_BIT;
+  AnsNvmeWrite32 (NVME_CC, Cc);
+
+  return AnsWaitRegisterBits (NVME_CSTS, NVME_CSTS_RDY_BIT, NVME_ENABLE_TIMEOUT_USEC);
+}
+
+STATIC
+BOOLEAN
+AnsControllerShutdown (
+  VOID
+  )
+{
+  UINT32  Cc;
+
+  Cc  = AnsNvmeRead32 (NVME_CC);
+  Cc &= ~(UINT32)(BIT15 | BIT14);
+  Cc |= (NVME_CC_SHN_NORMAL << NVME_CC_SHN_START);
+  AnsNvmeWrite32 (NVME_CC, Cc);
+
+  return AnsWaitRegister (
+           NVME_CSTS,
+           (UINT32)((BIT3 | BIT2)),
+           (UINT32)(NVME_CSTS_SHST_DONE << NVME_CSTS_SHST_START),
+           NVME_SHUTDOWN_TIMEOUT_USEC
+           );
+}
+
+STATIC
+EFI_STATUS
+AnsCreateIoQueues (
+  VOID
+  )
+{
+  APPLE_NVME_COMMAND  Command;
+  EFI_STATUS          Status;
+
+  ZeroMem (&Command, sizeof (Command));
+  Command.Opcode = NVME_ADMIN_CMD_CREATE_CQ;
+  Command.Prp1   = (UINT64)(UINTN)mAns.IoQueue.Cqes;
+  Command.Cdw10  = 1;                       // completion queue id
+  Command.Cdw10 |= (NVME_QUEUE_SIZE - 1) << 16;
+  Command.Cdw11  = NVME_QUEUE_CONTIGUOUS;
+
+  Status = AnsExecuteCommand (&mAns.AdminQueue, &Command, NULL);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "ans: create completion queue failed: %r\n", Status));
+    return Status;
+  }
+
+  ZeroMem (&Command, sizeof (Command));
+  Command.Opcode = NVME_ADMIN_CMD_CREATE_SQ;
+  Command.Prp1   = (UINT64)(UINTN)mAns.IoQueue.Cmds;
+  Command.Cdw10  = 1;                       // submission queue id
+  Command.Cdw10 |= (NVME_QUEUE_SIZE - 1) << 16;
+  Command.Cdw11  = NVME_QUEUE_CONTIGUOUS;
+  Command.Cdw11 |= 1 << 16;                 // completion queue this SQ is bound to
+
+  Status = AnsExecuteCommand (&mAns.AdminQueue, &Command, NULL);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "ans: create submission queue failed: %r\n", Status));
+    return Status;
+  }
+
+  if (mAns.Type == ANS_TYPE_T8132) {
+    //
+    // M4 and later need the IO queue addresses again after the queues exist;
+    // without these two writes the ANS crashes with "I/O SQ: 0 / I/O CQ: 0".
+    //
+    AnsNvmeWrite64 (NVME_IOQ_CQES, (UINT64)(UINTN)mAns.IoQueue.Cqes);
+    AnsNvmeWrite64 (NVME_IOQ_CMDS, (UINT64)(UINTN)mAns.IoQueue.Cmds);
+  }
+
+  return EFI_SUCCESS;
+}
