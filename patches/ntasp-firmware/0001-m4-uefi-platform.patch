+INTN
+AppleRtkitRecv (
+  IN  APPLE_RTKIT_DEV      *Rtk,
+  OUT APPLE_RTKIT_MESSAGE  *Msg
+  );
+
+BOOLEAN
+AppleRtkitSend (
+  IN APPLE_RTKIT_DEV            *Rtk,
+  IN CONST APPLE_RTKIT_MESSAGE  *Msg
+  );
+
+//
+// ---------------------------------------------------------------------------
+// NVMe engine and NVMMU.  Two register layouts: M1-M3 (T8103) put the NVMMU and
+// the NVMe registers in the same region (reg[3] of /arm-io/ans); M4 and later
+// (T8132) separate them (NVMMU reg[3], NVMe reg[9]) and need two extra writes
+// after the IO queues are created, or the ANS crashes.
+// ---------------------------------------------------------------------------
+//
+#define ANS_TYPE_T8103  0
+#define ANS_TYPE_T8132  1
+
+#define NVME_TIMEOUT_USEC           1000000
+#define NVME_ENABLE_TIMEOUT_USEC    5000000
+#define NVME_SHUTDOWN_TIMEOUT_USEC  5000000
+#define NVME_QUEUE_SIZE             64
+#define NVME_DEFAULT_BLOCK_SIZE     4096
+
+#define NVME_CC                0x14
+#define NVME_CC_SHN_START      14
+#define NVME_CC_SHN_END        15
+#define NVME_CC_SHN_NONE       0
+#define NVME_CC_SHN_NORMAL     1
+#define NVME_CC_SHN_ABRUPT     2
+#define NVME_CC_EN_BIT         0
+
+#define NVME_CSTS               0x1c
+#define NVME_CSTS_SHST_START    2
+#define NVME_CSTS_SHST_END      3
+#define NVME_CSTS_SHST_NORMAL   0
+#define NVME_CSTS_SHST_BUSY     1
+#define NVME_CSTS_SHST_DONE     2
+#define NVME_CSTS_RDY_BIT       0
+
+#define NVME_AQA  0x24
+#define NVME_ASQ  0x28
+#define NVME_ACQ  0x30
+
+#define NVME_DB_ACQ   0x1004
+#define NVME_DB_IOCQ  0x100c
+
+#define NVME_BOOT_STATUS     0x1300
+#define NVME_BOOT_STATUS_OK  0xde71ce55
+
+#define NVME_LINEAR_SQ_CTRL     0x24908
+#define NVME_LINEAR_SQ_CTRL_EN  BIT0
+
+#define NVME_IOQ_CMDS            0x1200
+#define NVME_IOQ_CQES            0x1208
+#define NVME_MAX_PEND_CMDS_CTRL  0x1210
+#define NVME_DB_LINEAR_ASQ       0x2490c
+#define NVME_DB_LINEAR_IOSQ      0x24910
+
+#define NVMMU_NUM        0x28100
+#define NVMMU_ASQ_BASE   0x28108
+#define NVMMU_IOSQ_BASE  0x28110
+#define NVMMU_TCB_INVAL  0x28118
+#define NVMMU_TCB_STAT   0x29120
+
+#define NVME_ADMIN_CMD_DELETE_SQ  0x00
+#define NVME_ADMIN_CMD_CREATE_SQ  0x01
+#define NVME_ADMIN_CMD_DELETE_CQ  0x04
+#define NVME_ADMIN_CMD_CREATE_CQ  0x05
+#define NVME_ADMIN_CMD_IDENTIFY   0x06
+#define NVME_QUEUE_CONTIGUOUS     BIT0
+
+#define NVME_CMD_FLUSH  0x00
+#define NVME_CMD_WRITE  0x01
+#define NVME_CMD_READ   0x02
+
+#define NVMMU_TCB_DMA_FROM_DEVICE  BIT0
+#define NVMMU_TCB_DMA_TO_DEVICE    BIT1
+
+#define NVME_CNS_NAMESPACE  0x00
+#define NVME_CNS_CONTROLLER 0x01
+
+//
+// Apple's NVMe submission entry: the tag is a single byte and the rest of the
+// standard 16-bit CID field is reserved.
+//
+typedef struct {
+  UINT8     Opcode;
+  UINT8     Flags;
+  UINT8     Tag;
+  UINT8     Rsvd;
+  UINT32    Nsid;
+  UINT32    Cdw2;
+  UINT32    Cdw3;
+  UINT64    Metadata;
+  UINT64    Prp1;
+  UINT64    Prp2;
+  UINT32    Cdw10;
+  UINT32    Cdw11;
+  UINT32    Cdw12;
+  UINT32    Cdw13;
+  UINT32    Cdw14;
+  UINT32    Cdw15;
+} APPLE_NVME_COMMAND;
+
+typedef struct {
+  UINT64    Result;
+  UINT32    Rsvd;
+  UINT16    Tag;
+  UINT16    Status;
+} APPLE_NVME_COMPLETION;
+
+//
+// One NVMMU TCB per submission slot.  The NVMe engine is given TCBs, not
+// commands: the TCB carries the DMA direction, the transfer length and the
+// PRP list for the command in the matching slot.
+//
+typedef struct {
+  UINT8     Opcode;
+  UINT8     DmaFlags;
+  UINT8     SlotId;
+  UINT8     Unk0;
+  UINT32    Len;
+  UINT64    Unk1[2];
+  UINT64    Prp1;
+  UINT64    Prp2;
+  UINT64    Unk2[2];
+  UINT8     AesIv[8];
+  UINT8     AesUnk[64];
+} APPLE_NVMMU_TCB;
+
+typedef struct {
+  APPLE_NVMMU_TCB       *Tcbs;
+  APPLE_NVME_COMMAND    *Cmds;
+  APPLE_NVME_COMPLETION *Cqes;
+
+  UINT8                 CqHead;
+  UINT8                 CqPhase;
+  BOOLEAN               AdminQueue;
+} APPLE_NVME_QUEUE;
+
+//
+// Identify Namespace, only the fields the driver reads.  FLBAS selects the
+// active LBA format from the 16-entry LBAF array at offset 128.
+//
+#define NVME_IDENTIFY_FLBAS_OFFSET  26
+#define NVME_IDENTIFY_LBAF_OFFSET   128
+#define NVME_IDENTIFY_LBAF_STRIDE   4
+#define NVME_IDENTIFY_LBAF_LBADS    2
+
+typedef struct {
+  UINT64    Nsze;
+  UINT64    Ncap;
+  UINT64    Nuse;
+  UINT8     Nsfeat;
+  UINT8     NlbaFormat;
+  UINT8     Flbas;
+  UINT8     Rsvd[101];
+  UINT8     LbaFormat[64];
+  UINT8     Rsvd2[192];
+  UINT8     VendorSpecific[3712];
+} APPLE_NVME_IDENTIFY_NAMESPACE;
+
+#endif /* APPLE_NAND_STORAGE_H */
diff --git a/Silicon/Apple/AppleSiliconPkg/Drivers/AppleNANDStorageDxe/AppleRtkit.c b/Silicon/Apple/AppleSiliconPkg/Drivers/AppleNANDStorageDxe/AppleRtkit.c
