--- /dev/null
+++ b/Platform/Mac16_3Pkg/AcpiTables/MCFG.aslc
@@ -0,0 +1,64 @@
+/**
+ * Copyright (c) 2025 NTASP authors.
+ *
+ * Module Name:
+ *     MCFG.aslc
+ *
+ * Abstract:
+ *     Memory Mapped Configuration Space Access Table for the iMac M4
+ *     (Mac16,3 / J624).  The APCIE root complex exposes 256 MB of ECAM at
+ *     0x1cb0000000 and forwards buses 0-8; docs/pcie.md records the raw
+ *     device-tree cells this came from.
+ *
+ *     This table only tells the OS where configuration space is.  It does
+ *     not enable PCIe by itself: PCI0 in the DSDT describes the same
+ *     aperture, and the APCIE DARTs still have to be programmed before a
+ *     device can DMA.
+ *
+ * Environment:
+ *     UEFI firmware/runtime services.
+ *
+ * License:
+ *     SPDX-License-Identifier: BSD-2-Clause-Patent OR MIT
+ *
+ **/
+
+#include <Library/AcpiLib.h>
+#include <Library/PcdLib.h>
+#include <IndustryStandard/MemoryMappedConfigurationSpaceAccessTable.h>
+#include <Acpi/AcpiHeader.h>
+
+#pragma pack (1)
+
+typedef struct {
+  EFI_ACPI_MEMORY_MAPPED_CONFIGURATION_BASE_ADDRESS_TABLE_HEADER    Header;
+  EFI_ACPI_MEMORY_MAPPED_ENHANCED_CONFIGURATION_SPACE_BASE_ADDRESS_ALLOCATION_STRUCTURE Allocation[1];
+} MCFG_TABLE;
+
+#pragma pack ()
+
+STATIC MCFG_TABLE Mcfg = {
+  {
+    __ACPI_HEADER (
+      EFI_ACPI_2_0_MEMORY_MAPPED_CONFIGURATION_BASE_ADDRESS_TABLE_SIGNATURE,
+      MCFG_TABLE,
+      EFI_ACPI_MEMORY_MAPPED_CONFIGURATION_SPACE_ACCESS_TABLE_REVISION
+    ),
+    0, // Reserved
+  },
+  {
+    {
+      FixedPcdGet64 (PcdPciExpressBaseAddress),
+      0, // PciSegmentGroupNumber, one segment on this platform
+      (UINT8)FixedPcdGet32 (PcdPciBusMin),
+      (UINT8)FixedPcdGet32 (PcdPciBusMax),
+      0  // Reserved
+    }
+  }
+};
+
+//
+// Reference the table being generated to prevent the optimizer from removing
+// the data structure from the executable.
+//
+VOID* CONST ReferenceAcpiTable = &Mcfg;
