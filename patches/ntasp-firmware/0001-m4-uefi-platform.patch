diff --git a/Silicon/Apple/AppleSiliconPkg/Drivers/AppleNANDStorageDxe/AppleNandStorage.h b/Silicon/Apple/AppleSiliconPkg/Drivers/AppleNANDStorageDxe/AppleNandStorage.h
